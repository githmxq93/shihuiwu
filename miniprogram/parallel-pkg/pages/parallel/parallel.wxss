/* ═══════════ 平行时空 · UI v2 ═══════════
   保留宣纸古风底色，重做层次、双流对照、加载态与浮层。
   设计 token 全部收敛到 .page，改配色只动这一处。 */
.page {
  --paper: #F4EDE1;
  --card: #FCF9F2;
  --ink: #3B2C1D;
  --ink2: #6B5840;
  --muted: #8A7B62;
  --line: #E4D9C5;
  --china: #B5713A;
  --china-d: #8E4F27;
  --world: #3F6B68;
  --world-d: #2E5452;
  --warn: #A63B2A;
  position: relative;
  min-height: 100vh;
  background: var(--paper);
}
.bg-grain {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
  background-image:
    radial-gradient(circle at 12% 8%, rgba(181,113,58,0.07), transparent 38%),
    radial-gradient(circle at 88% 42%, rgba(63,107,104,0.05), transparent 42%),
    radial-gradient(circle at 30% 88%, rgba(181,113,58,0.05), transparent 40%);
}
.body { height: 100vh; position: relative; z-index: 1; }
.nav-spacer { width: 100%; }

/* ── 选择区：题头 ── */
.hero { padding: 30rpx 44rpx 8rpx; }
.hero-eyebrow { display: flex; align-items: center; gap: 14rpx; font-size: 20rpx; color: #B08A57; letter-spacing: 0; }
.eb-line { width: 46rpx; height: 2rpx; background: linear-gradient(90deg, rgba(181,113,58,0), rgba(181,113,58,0.65)); }
.hero-eyebrow .eb-line:last-child { background: linear-gradient(90deg, rgba(181,113,58,0.65), rgba(181,113,58,0)); }
.hero-row { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; }
.hero-main { flex: 1; min-width: 0; }
.hero-title { font-size: 62rpx; font-weight: 600; color: var(--ink); font-family: "Songti SC", "STSong", serif; letter-spacing: 0; line-height: 1.2; }
.hero-accent { color: var(--china); }
.hero-sub { margin-top: 12rpx; font-size: var(--fs-24); color: var(--muted); line-height: 1.6; }
.hero-seal { flex-shrink: 0; width: 92rpx; height: 92rpx; margin-left: 20rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx solid rgba(181,113,58,0.5); border-radius: 18rpx; background: rgba(181,113,58,0.06); color: var(--china-d); font-family: "Songti SC", "STSong", serif; font-size: var(--fs-30); line-height: 1.15; letter-spacing: 0; transform: rotate(6deg); box-shadow: inset 0 0 0 4rpx rgba(251,247,239,0.7); }
.hero-rule { position: relative; height: 2rpx; margin-top: 30rpx; background: linear-gradient(90deg, rgba(181,113,58,0.4), rgba(181,113,58,0)); }
.hr-dot { position: absolute; left: 0; top: -5rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--china); }

/* ── 选择区：深色锚点卡（方案 B）──
   把「时间锚点」定位、选人物/选年份分段、搜索框收进同一张卡；
   卡本身不做 overflow:hidden，联想面板才能溢出卡片显示。 */
.anchor-card {
  position: relative;
  z-index: 20;
  margin: 20rpx 36rpx 0;
  padding: 30rpx 30rpx 32rpx;
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 92% 0%, rgba(181,113,58,0.32), rgba(181,113,58,0) 55%),
    linear-gradient(135deg, #3B2C1D 0%, #2A1F14 60%, #4A3521 100%);
  box-shadow: 0 36rpx 72rpx -44rpx rgba(59,44,29,0.9);
}
.ac-top { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.ac-chip { display: flex; align-items: center; gap: 12rpx; padding: 8rpx 20rpx; border-radius: 999rpx; background: rgba(252,249,242,0.1); border: 2rpx solid rgba(252,249,242,0.14); color: #E7D6BA; font-size: var(--fs-20); }
.ac-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #D9A566; box-shadow: 0 0 0 6rpx rgba(217,165,102,0.16); }
.ac-note { font-size: var(--fs-20); color: rgba(231,214,186,0.75); }
.ac-hint { position: relative; margin-top: 18rpx; font-size: var(--fs-20); line-height: 1.6; color: rgba(231,214,186,0.8); }

.anchor-card .anchor-tabs { margin: 24rpx 0 0; padding: 6rpx; background: rgba(252,249,242,0.09); border: 2rpx solid rgba(252,249,242,0.12); border-radius: 999rpx; box-shadow: none; }
.anchor-card .at { height: 68rpx; padding: 0 14rpx; box-sizing: border-box; color: #E7D6BA; }
.anchor-card .at.on { background: #FCF9F2; color: var(--china-d); font-weight: 600; box-shadow: 0 8rpx 20rpx -10rpx rgba(0,0,0,0.6); }
.anchor-card .at-ico { background: rgba(252,249,242,0.14); color: #E7D6BA; }
.anchor-card .at.on .at-ico { background: rgba(181,113,58,0.14); color: var(--china-d); }
.anchor-card .search-box { height: 84rpx; margin: 20rpx 0 0; background: rgba(252,249,242,0.97); border-color: transparent; box-shadow: none; }
.anchor-card .search-box.focused { border-color: rgba(181,113,58,0.55); box-shadow: 0 0 0 6rpx rgba(181,113,58,0.1); }

.anchor-tabs, .view-tabs { display: flex; gap: 12rpx; margin: 30rpx 40rpx 0; padding: 6rpx; background: var(--bg-card); border: 2rpx solid var(--line); border-radius: 999rpx; box-shadow: inset 0 2rpx 8rpx rgba(61,46,31,0.04); }
.at, .vt { flex: 1; display: flex; align-items: center; justify-content: center; gap: 12rpx; padding: 14rpx; font-size: var(--fs-28); color: var(--muted); border-radius: 999rpx; }
.at.on, .vt.on { background: linear-gradient(135deg, var(--accent-gold), #8E4F27); color: var(--bg-card); font-weight: 500; box-shadow: 0 10rpx 20rpx -10rpx rgba(142,79,39,0.9); }
.at-ico { width: 36rpx; height: 36rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(181,113,58,0.1); color: var(--china-d); font-size: var(--fs-20); font-family: "Songti SC", "STSong", serif; }
.at.on .at-ico { background: rgba(251,247,239,0.22); color: var(--bg-card); }
.at-txt { line-height: 1.2; }
.vt { font-size: var(--fs-26); }
.vt-ico { font-size: var(--fs-26); opacity: 0.85; }

/* ── 搜索框与联想 ── */
.search-box { position: relative; z-index: 30; display: flex; align-items: center; margin: 28rpx 40rpx 0; padding: 0 24rpx; height: 88rpx; background: var(--card); border: 2rpx solid var(--line); border-radius: 999rpx; box-shadow: 0 14rpx 30rpx -18rpx rgba(163,149,137,0.65); }
.search-box.focused { border-color: rgba(181,113,58,0.55); box-shadow: 0 0 0 6rpx rgba(181,113,58,0.08), 0 14rpx 30rpx -18rpx rgba(163,149,137,0.65); }
.search-icon { position: relative; width: 32rpx; height: 32rpx; margin-right: 18rpx; flex-shrink: 0; }
.search-icon-circle { width: 22rpx; height: 22rpx; border: 4rpx solid var(--muted); border-radius: 50%; box-sizing: border-box; }
.search-icon-handle { position: absolute; right: 2rpx; bottom: 2rpx; width: 12rpx; height: 4rpx; border-radius: 2rpx; background: var(--muted); transform: rotate(45deg); }
.search-input { flex: 1; height: 84rpx; font-size: var(--fs-28); color: var(--ink); }
.search-placeholder { color: #9A8C73; }
.search-clear { width: 40rpx; height: 40rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(61,46,31,0.07); font-size: 22rpx; color: var(--muted); }

.sug-dropdown { position: absolute; top: 100rpx; left: 0; right: 0; padding: 12rpx; background: var(--card); border: 2rpx solid var(--line); border-radius: 24rpx; box-shadow: 0 20rpx 48rpx rgba(61,46,31,0.18); z-index: 40; overflow: hidden; }
.sug-head { padding: 6rpx 12rpx 12rpx; font-size: 20rpx; color: #A2937A; letter-spacing: 0; }
.sug-item { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 14rpx; border-radius: 14rpx; border-bottom: 1rpx solid rgba(228,217,197,0.7); }
.sug-item:last-child { border-bottom: none; }
.sug-item-hover { background: rgba(181,113,58,0.08); }
.sug-idx { flex-shrink: 0; width: 30rpx; font-size: 20rpx; color: #B08A57; font-family: "Songti SC", "STSong", serif; }
/* 检索结果的「域外 / 中土」归属徽标：域外只落右列，中土只落左列 */
.sug-kind { flex-shrink: 0; font-size: 18rpx; line-height: 1; padding: 6rpx 10rpx; border-radius: 8rpx; color: var(--china-d); background: rgba(181,113,58,0.11); border: 1rpx solid rgba(181,113,58,0.22); letter-spacing: 0; }
.sug-kind.is-world { color: var(--bg-card); background: var(--world); border-color: var(--world); }
.sug-name { flex: 1; font-size: var(--fs-28); color: var(--ink); }
.sug-dynasty { flex-shrink: 0; font-size: var(--fs-20); color: var(--china-d); background: rgba(181,113,58,0.11); padding: 3rpx 14rpx; border-radius: 999rpx; }
.sug-arrow { flex-shrink: 0; font-size: var(--fs-30); color: #C9B79B; }

/* ── 区块标题 ── */
.section-label { display: flex; align-items: center; margin: 40rpx 40rpx 20rpx; font-size: var(--fs-26); color: var(--ink2); font-weight: 500; letter-spacing: 0; }
.sl-bar { width: 6rpx; height: 26rpx; margin-right: 12rpx; border-radius: 999rpx; background: var(--china); }
.sl-en { margin-left: auto; font-size: var(--fs-20); color: #A2937A; font-weight: 400; letter-spacing: 0; }

/* ── 热门人物：两列精选卡 ── */
.hot-grid { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 0 40rpx; }
.hot-card { position: relative; width: 48.5%; box-sizing: border-box; height: 116rpx; margin-bottom: 20rpx; padding: 0 18rpx; display: flex; align-items: center; gap: 16rpx; overflow: hidden; background: var(--card); border: 2rpx solid var(--line); border-radius: 22rpx; box-shadow: 0 12rpx 26rpx -18rpx rgba(163,149,137,0.7); }
.hot-card-hover { background: rgba(181,113,58,0.08); }
.hot-idx { position: absolute; right: 16rpx; top: 8rpx; font-size: 18rpx; color: rgba(61,46,31,0.26); font-family: "Songti SC", "STSong", serif; }
.hot-badge { flex-shrink: 0; width: 64rpx; height: 64rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; background: rgba(181,113,58,0.1); border: 2rpx solid rgba(181,113,58,0.3); color: var(--china-d); font-size: var(--fs-30); font-weight: 600; font-family: "Songti SC", "STSong", serif; }
.hot-name { flex: 1; min-width: 0; font-size: var(--fs-26); font-weight: 600; color: var(--ink); }
.hot-arrow { flex-shrink: 0; font-size: var(--fs-28); color: #C9B79B; }

/* ── 年份输入与快捷锚点 ── */
.year-box { display: flex; align-items: center; gap: 16rpx; margin: 28rpx 40rpx 0; }
.year-field { flex: 1; min-width: 0; display: flex; align-items: center; height: 88rpx; padding: 0 24rpx; background: var(--card); border: 2rpx solid var(--line); border-radius: 999rpx; box-shadow: 0 14rpx 30rpx -18rpx rgba(163,149,137,0.65); }
.year-prefix { flex-shrink: 0; padding-right: 16rpx; margin-right: 16rpx; border-right: 1rpx solid var(--line); font-size: var(--fs-22); color: #B08A57; letter-spacing: 0; }
.year-input { flex: 1; min-width: 0; height: 84rpx; font-size: var(--fs-28); color: var(--ink); }
.year-placeholder { color: #9A8C73; }
.year-go { flex-shrink: 0; height: 88rpx; padding: 0 34rpx; display: flex; align-items: center; gap: 8rpx; background: linear-gradient(135deg, var(--accent-gold), #8E4F27); color: var(--bg-card); border-radius: 999rpx; font-size: var(--fs-28); box-shadow: 0 14rpx 26rpx -14rpx rgba(142,79,39,0.9); }
.yg-arrow { font-size: var(--fs-30); opacity: 0.8; }
.year-err { display: flex; align-items: center; gap: 10rpx; margin: 14rpx 40rpx 0; padding: 10rpx 18rpx; background: rgba(166,59,42,0.07); border-radius: 12rpx; font-size: 24rpx; color: var(--warn); }
.ye-mark { width: 28rpx; height: 28rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--warn); color: var(--bg-card); font-size: 20rpx; }

.pick-grid { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 0 40rpx; }
.pick-card { position: relative; width: 31.5%; box-sizing: border-box; margin-bottom: 20rpx; padding: 24rpx 6rpx 20rpx; background: var(--card); border: 2rpx solid var(--line); border-radius: 20rpx; text-align: center; box-shadow: 0 12rpx 24rpx -18rpx rgba(163,149,137,0.7); }
.pick-card-hover { background: rgba(181,113,58,0.08); }
.pick-dot { position: absolute; left: 50%; top: -7rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--china); border: 3rpx solid var(--paper); transform: translateX(-50%); box-sizing: content-box; }
.pick-year { font-size: var(--fs-32); font-weight: 600; color: var(--ink); font-family: "Songti SC", "STSong", serif; }
.pick-tag { margin-top: 8rpx; font-size: var(--fs-20); color: var(--muted); }

.intro { display: flex; align-items: flex-start; gap: 18rpx; margin: 36rpx 40rpx 0; padding: 24rpx 26rpx; background: rgba(181,113,58,0.07); border-left: 6rpx solid var(--china); border-radius: 0 20rpx 20rpx 0; }
.intro-mark { flex-shrink: 0; width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(181,113,58,0.6); border-radius: 50%; color: var(--china-d); font-size: var(--fs-22); font-family: serif; }
.intro-text { flex: 1; font-size: 24rpx; color: var(--ink2); line-height: 1.75; }
.intro-tip { display: block; margin-top: 10rpx; font-size: 22rpx; color: #A08A68; }

/* ── 结果头部：锚点卡 ── */
.anchor-head { position: relative; overflow: hidden; margin: 24rpx 36rpx 0; padding: 28rpx 30rpx 24rpx; border-radius: var(--radius-lg); background: linear-gradient(135deg, #3B2C1D 0%, #2A1F14 60%, #4A3521 100%); box-shadow: 0 22rpx 46rpx -26rpx rgba(59,44,29,0.9); }
.ah-glow { position: absolute; right: -60rpx; top: -80rpx; width: 260rpx; height: 260rpx; border-radius: 50%; background: radial-gradient(circle, rgba(181,113,58,0.42), rgba(181,113,58,0) 70%); pointer-events: none; }
.ah-watermark { position: absolute; right: 18rpx; bottom: -34rpx; font-size: 132rpx; font-family: "Songti SC", "STSong", serif; color: rgba(251,247,239,0.055); letter-spacing: -4rpx; pointer-events: none; }
.ah-top { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; }
.ah-chip { display: flex; align-items: center; gap: 10rpx; padding: 6rpx 18rpx; border-radius: 999rpx; background: rgba(251,247,239,0.1); border: 1rpx solid rgba(251,247,239,0.14); color: #E7D6BA; font-size: 20rpx; letter-spacing: 1rpx; }
.ah-chip-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #D9A566; box-shadow: 0 0 0 4rpx rgba(217,165,102,0.18); }
.ah-reselect { display: flex; align-items: center; gap: 6rpx; flex-shrink: 0; padding: 10rpx 22rpx; border: 1rpx solid rgba(251,247,239,0.35); border-radius: 999rpx; color: #FBF7EF; font-size: 23rpx; }
.ah-arrow { font-size: var(--fs-28); opacity: 0.8; }
.ah-main { position: relative; z-index: 1; margin-top: 22rpx; }
.ah-title { font-size: 44rpx; font-weight: 600; color: #FBF7EF; font-family: "Songti SC", "STSong", serif; letter-spacing: 2rpx; line-height: 1.25; }
.ah-sub { margin-top: 10rpx; font-size: 23rpx; color: #C9B79B; letter-spacing: 1rpx; }
.ah-others { margin-top: 8rpx; font-size: 21rpx; color: #A89474; line-height: 1.5; }
.ah-basis { margin-top: 12rpx; font-size: var(--fs-20); color: #F0D9B0; background: rgba(181,113,58,0.32); display: inline-block; padding: 5rpx 16rpx; border-radius: 999rpx; }
.ah-foot { position: relative; z-index: 1; display: flex; align-items: center; gap: 22rpx; margin-top: 26rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(251,247,239,0.12); }
.ah-seal { flex-shrink: 0; width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(217,165,102,0.65); border-radius: 14rpx; background: rgba(217,165,102,0.08); }
.ah-seal text { font-family: "Songti SC", "STSong", serif; font-size: 28rpx; color: #E9C48D; letter-spacing: 2rpx; }
.ah-metrics { flex: 1; display: flex; align-items: center; justify-content: space-around; gap: 16rpx; }
.ah-metric { display: flex; flex-direction: column; align-items: center; }
.am-num { font-family: "Songti SC", "STSong", serif; font-size: var(--fs-32); color: var(--bg-card); line-height: 1.1; }
.am-label { margin-top: 6rpx; font-size: 19rpx; color: #A89474; }
.am-div { width: 1rpx; height: 40rpx; background: rgba(251,247,239,0.16); }

/* ── 二级入口：这一年，谁在场（方案 C · 年份区下方小卡）──
   贴着深色锚点卡，用浅金纸面承接；两行结构，首行标题、次行三项计数。
   数字为 0 的项由 JS 过滤（whoNums），不出现「0 出生」这类空项。 */
.who-entry { margin: 18rpx 36rpx 0; padding: 18rpx 24rpx 20rpx; border-radius: 22rpx; background: linear-gradient(135deg, #FBF7EF 0%, #F7EEDD 100%); border: 2rpx solid #E3D3B6; box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.6); }
.who-entry-hover { background: linear-gradient(135deg, #F7EEDD 0%, #F2E6CE 100%); }
.we-top { display: flex; align-items: center; gap: 12rpx; }
.we-dot { flex-shrink: 0; width: 10rpx; height: 10rpx; background: var(--china); transform: rotate(45deg); }
.we-title { font-family: "Songti SC", "STSong", serif; font-size: 25rpx; font-weight: 600; color: var(--ink); }
.we-em { color: var(--china-d); }
.we-go { margin-left: auto; font-size: 24rpx; color: var(--china-d); }
.we-nums { display: flex; margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx dashed #E3D3B6; }
.we-n { flex: 1; display: flex; align-items: baseline; gap: 8rpx; }
.we-n + .we-n { padding-left: 20rpx; border-left: 1rpx solid #E7DBC6; }
.we-num { font-family: "Songti SC", "STSong", serif; font-size: 30rpx; font-weight: 600; color: var(--ink); line-height: 1; }
.we-lab { font-size: 17rpx; color: var(--muted); }
.we-n.gold .we-num { color: var(--china-d); }
.we-n.grey .we-num { color: #8A7B62; }

/* ── 平行双流 ── */
.dual { display: flex; align-items: stretch; margin: 28rpx 28rpx 0; }
.dual-col { flex: 1; min-width: 0; box-sizing: border-box; }
.dual-col.left { padding-right: 8rpx; }
.dual-col.right { padding-left: 8rpx; }
.dual-axis { width: 40rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; padding-top: 4rpx; }
.axis-node { position: relative; z-index: 2; flex-shrink: 0; width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: linear-gradient(135deg, var(--accent-gold), #8E4F27); color: var(--bg-card); font-size: var(--fs-20); box-shadow: 0 0 0 6rpx rgba(181,113,58,0.12); }
.axis-line { flex: 1; min-height: 120rpx; width: 2rpx; margin: 10rpx 0; background: linear-gradient(180deg, rgba(181,113,58,0.55), rgba(63,107,104,0.4)); }
.axis-end { flex-shrink: 0; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--world); }

.col-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; padding: 16rpx 14rpx; border-radius: var(--radius); }
.ch-mark { flex-shrink: 0; width: 8rpx; height: 36rpx; border-radius: 999rpx; }
.ch-body { min-width: 0; }
.ch-name { font-size: var(--fs-24); font-weight: 600; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ch-sub { margin-top: 4rpx; font-size: 20rpx; letter-spacing: 1rpx; opacity: 0.75; }
.col-china { color: var(--china-d); background: rgba(181,113,58,0.1); border: 1rpx solid rgba(181,113,58,0.16); }
.col-china .ch-mark { background: var(--china); }
.col-world { color: var(--world-d); background: rgba(63,107,104,0.09); border: 1rpx solid rgba(63,107,104,0.16); }
.col-world .ch-mark { background: var(--world); }

.mini-card { position: relative; overflow: hidden; margin-bottom: 16rpx; padding: 18rpx 18rpx 16rpx; background: var(--card); border: 1rpx solid var(--line); border-radius: 18rpx; box-shadow: 0 10rpx 24rpx -18rpx rgba(61,46,31,0.6); }
.mini-card-hover { background: rgba(181,113,58,0.06); }
.china-card { border-left: 6rpx solid var(--china); }
.world-card { border-left: 6rpx solid var(--world); }
.mc-top { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-bottom: 10rpx; }
.mc-tag { flex-shrink: 0; font-size: var(--fs-20); color: var(--china-d); background: rgba(181,113,58,0.12); padding: 3rpx 12rpx; border-radius: 999rpx; }
.world-tag { color: var(--world-d); background: rgba(63,107,104,0.12); }
.mc-no { flex-shrink: 0; font-size: var(--fs-20); color: rgba(61,46,31,0.3); font-family: "Songti SC", "STSong", serif; }
.mc-diff { flex-shrink: 0; font-size: var(--fs-20); color: var(--world-d); background: rgba(63,107,104,0.1); padding: 3rpx 10rpx; border-radius: 999rpx; }
.mc-diff.same { color: var(--china-d); background: rgba(181,113,58,0.16); font-weight: 600; }
.mc-book-tag { flex-shrink: 0; font-size: 20rpx; color: var(--china-d); border: 1rpx solid rgba(181,113,58,0.36); padding: 2rpx 10rpx; border-radius: 999rpx; }
.mc-title { font-size: 27rpx; font-weight: 600; color: var(--ink); line-height: 1.45; }
.mc-sub { margin-top: 6rpx; font-size: var(--fs-20); color: var(--china-d); line-height: 1.4; }
.mc-desc { margin-top: 8rpx; font-size: 21rpx; color: var(--muted); line-height: 1.6; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden; }
.mc-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; padding-top: 10rpx; border-top: 1rpx dashed var(--line); font-size: var(--fs-20); color: var(--china-d); }
.mc-foot-arrow { font-size: var(--fs-26); }
.mc-impact { margin-top: 12rpx; padding: 10rpx 12rpx; background: rgba(63,107,104,0.07); border-left: 3rpx solid rgba(63,107,104,0.5); border-radius: 0 12rpx 12rpx 0; }
.mi-label { margin-right: 8rpx; font-size: 19rpx; color: var(--world-d); font-weight: 600; }
.mi-text { font-size: var(--fs-20); color: #5C716E; line-height: 1.55; }

/* 域外同期人物块：与域外事件共用 .mini-card / .world-card 视觉语言 */
.fig-block { margin-top: 4rpx; }
.fig-block-head { display: flex; align-items: center; gap: 10rpx; margin: 6rpx 0 14rpx; padding: 0 4rpx; }
.fb-mark { width: 6rpx; height: 24rpx; border-radius: 999rpx; background: var(--world); }
.fb-title { font-size: 22rpx; font-weight: 600; color: var(--world-d); letter-spacing: 1rpx; }
.fb-count { margin-left: auto; font-size: 19rpx; color: var(--muted); }
.mc-en { font-size: 21rpx; color: var(--muted); font-weight: 400; }

/* 搜到的域外人物：右列置顶高亮，明确标为时间锚点 */
.world-fig.is-anchor { background: rgba(63,107,104,0.1); border: 2rpx solid rgba(63,107,104,0.42); border-left: 8rpx solid var(--world); box-shadow: 0 14rpx 30rpx -20rpx rgba(63,107,104,0.9); }
.world-fig.is-anchor .mc-title { font-size: 32rpx; }
.wf-anchor-tag { flex-shrink: 0; font-size: 20rpx; color: var(--bg-card); background: var(--world); padding: 5rpx 14rpx; border-radius: 999rpx; letter-spacing: 0; }

.sk-card { margin-bottom: 16rpx; padding: 20rpx 18rpx; background: var(--card); border: 1rpx solid var(--line); border-radius: 18rpx; }
.sk-line { height: 18rpx; margin-bottom: 14rpx; border-radius: 999rpx; background: linear-gradient(90deg, #EFE7D7 25%, #F8F2E7 50%, #EFE7D7 75%); background-size: 200% 100%; animation: sk 1.4s linear infinite; }
.sk-line:last-child { margin-bottom: 0; }
.w30 { width: 30%; } .w60 { width: 60%; } .w85 { width: 85%; }
@keyframes sk { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

.col-empty { margin: 24rpx 6rpx; padding: 24rpx 10rpx; font-size: 21rpx; color: #9A8C73; text-align: center; line-height: 1.6; }
.empty-mark { width: 48rpx; height: 48rpx; margin: 0 auto 12rpx; border: 2rpx dashed #D8CBB2; border-radius: 50%; color: #C0AE90; font-size: var(--fs-24); line-height: 44rpx; text-align: center; }
.retry { margin: 4rpx auto 0; width: 200rpx; text-align: center; padding: 12rpx 0; background: var(--china); color: var(--bg-card); border-radius: 999rpx; font-size: var(--fs-24); }

/* 列尾统计：双流两列高度天然不等（中土 16 条 vs 域外 2 条时右列必有大片空白），
   用「共 N 条 / 查看该年全部」收口，比纯留白有意义 */
.col-foot { margin: 4rpx 2rpx 18rpx; padding-top: 12rpx; border-top: 1rpx dashed var(--line); text-align: center; }
.cf-line { font-size: 19rpx; color: var(--muted); letter-spacing: 0.5rpx; }
.cf-link { display: inline-flex; align-items: center; gap: 4rpx; margin-top: 12rpx; padding: 8rpx 22rpx; border: 1rpx solid rgba(181,113,58,0.35); border-radius: 999rpx; font-size: 21rpx; color: var(--china-d); }
.cf-arrow { font-size: var(--fs-24); }

/* 空态出口：原来只有一句话，看完无处可去 */
.empty-acts { display: flex; justify-content: center; gap: 14rpx; margin-top: 16rpx; }
.ea-btn { padding: 10rpx 26rpx; border-radius: 999rpx; background: var(--china); color: var(--bg-card); font-size: var(--fs-22); }
.ea-ghost { background: transparent; border: 1rpx solid rgba(181,113,58,0.4); color: var(--china-d); }

/* ── 世界地图 ── */
.map-view { margin: 28rpx 28rpx 0; }
.map-head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 16rpx; padding: 0 4rpx; }
.map-head-main { min-width: 0; }
.map-title { font-size: 27rpx; font-weight: 600; color: var(--ink); }
.map-sub { margin-top: 6rpx; font-size: var(--fs-20); color: var(--muted); }
.map-legend { display: flex; gap: 16rpx; }
.lg { display: flex; align-items: center; gap: 6rpx; font-size: 19rpx; color: var(--muted); }
.lg-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.lg-china { background: var(--china); }
.lg-world { background: var(--world); }
.map-canvas { position: relative; width: 100%; padding-bottom: 56%; overflow: hidden; background-color: #F5EDDD; border: 1rpx solid #DFD1B6; border-radius: 20rpx; background-size: 100% 100%; box-shadow: inset 0 2rpx 14rpx rgba(120,96,60,0.07), 0 8rpx 24rpx -18rpx rgba(61,46,31,0.55); background-image: url("data:image/svg+xml;base64,"); }
.map-arc-canvas { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }

/* 文明锚点：小圆点落在对应大陆，不再用大胶囊盖住轮廓 */
.map-pin { position: absolute; z-index: 2; width: 16rpx; height: 16rpx; box-sizing: border-box; border-radius: 50%; transform: translate(-50%, -50%); border: 2rpx solid #FCF9F2; box-shadow: 0 1rpx 5rpx rgba(61,46,31,0.35); }
.pin-china { width: 20rpx; height: 20rpx; background: var(--china); box-shadow: 0 0 0 3rpx rgba(181,113,58,0.2), 0 2rpx 8rpx rgba(142,79,39,0.5); }
.pin-china::after { content: ''; position: absolute; left: 50%; top: 50%; width: 100%; height: 100%; box-sizing: border-box; transform: translate(-50%, -50%); border: 2rpx solid rgba(181,113,58,0.55); border-radius: 50%; animation: pulse 2.4s ease-out infinite; pointer-events: none; }
@keyframes pulse { 0% { transform: translate(-50%, -50%) scale(1); opacity: 0.75; } 100% { transform: translate(-50%, -50%) scale(2.4); opacity: 0; } }
.pin-world { background: var(--world); }
.pin-idle { background: rgba(63,107,104,0.2); box-shadow: none; }
.pin-china.pin-idle { background: var(--china); }

/* 标签：有同期记载＝实心胶囊，无记载＝淡字；统一向外扇出 */
.map-tag { position: absolute; z-index: 3; display: flex; align-items: center; gap: 6rpx; transform: translate(-50%, -50%); padding: 5rpx 12rpx; border-radius: 999rpx; background: rgba(252,249,242,0.94); border: 1rpx solid rgba(63,107,104,0.4); box-shadow: 0 4rpx 12rpx rgba(61,46,31,0.16); transition: transform 0.18s, box-shadow 0.18s; }
.tag-label { font-size: var(--fs-20); line-height: 1.2; color: var(--world-d); white-space: nowrap; }
.tag-num { min-width: 24rpx; padding: 0 6rpx; border-radius: 999rpx; background: rgba(63,107,104,0.14); font-size: 18rpx; line-height: 24rpx; text-align: center; color: var(--world-d); }
.tag-china { background: linear-gradient(135deg, var(--accent-gold), #8E4F27); border-color: #8E4F27; box-shadow: 0 6rpx 16rpx rgba(142,79,39,0.35); }
.tag-china .tag-label { color: var(--bg-card); }
.tag-china .tag-num { background: rgba(251,247,239,0.22); color: var(--bg-card); }
/* 无同期记载：半透明纸底小字，落在陆地上也能读清，但不遮挡轮廓 */
.tag-idle { background: rgba(252,249,242,0.66); border-color: rgba(228,217,197,0.7); box-shadow: none; padding: 2rpx 8rpx; opacity: 0.88; }
.tag-idle .tag-label { color: #7A6B52; font-size: 19rpx; }
.tag-active { transform: translate(-50%, -50%) scale(1.12); box-shadow: 0 10rpx 22rpx rgba(46,84,82,0.4); }
.tag-china.tag-active { box-shadow: 0 10rpx 22rpx rgba(142,79,39,0.5); }
.map-note { position: absolute; right: 14rpx; bottom: 12rpx; z-index: 3; pointer-events: none; font-size: 16rpx; color: #A8977B; letter-spacing: 0.5rpx; }

.region-detail { margin-top: 20rpx; padding: 22rpx 24rpx; background: var(--card); border: 1rpx solid var(--line); border-radius: 20rpx; box-shadow: 0 12rpx 28rpx -20rpx rgba(61,46,31,0.7); }
.rd-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.rd-title-wrap { display: flex; align-items: baseline; gap: 12rpx; }
.rd-title { font-size: 29rpx; font-weight: 600; color: var(--ink); }
.rd-count { font-size: 19rpx; color: var(--world-d); background: rgba(63,107,104,0.1); padding: 3rpx 12rpx; border-radius: 999rpx; }
.rd-close { padding: 8rpx 12rpx; font-size: var(--fs-22); color: var(--muted); }
.rd-item { padding: 16rpx 0; border-top: 1rpx solid #EFE7D7; }
.rd-item-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.rd-item-title { flex: 1; font-size: var(--fs-26); color: var(--ink); font-weight: 500; }
.rd-item-year { flex-shrink: 0; font-size: var(--fs-20); color: var(--china-d); background: rgba(181,113,58,0.1); padding: 3rpx 10rpx; border-radius: 999rpx; }
.rd-item-desc { margin-top: 8rpx; font-size: 21rpx; color: var(--muted); line-height: 1.6; }
.rd-item-impact { margin-top: 8rpx; padding-top: 8rpx; font-size: var(--fs-20); color: var(--china-d); line-height: 1.5; border-top: 1rpx dashed #EFE7D7; }
.map-tip { display: flex; align-items: center; justify-content: center; gap: 10rpx; margin-top: 16rpx; padding: 14rpx 18rpx; background: rgba(61,46,31,0.04); border-radius: 14rpx; font-size: var(--fs-20); color: var(--muted); text-align: center; }
.tip-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--china); }

/* ── 分享 ── */
.share-row { margin: 36rpx 40rpx 0; text-align: center; }
.share-hint { margin-bottom: 18rpx; font-size: var(--fs-20); color: #9A8C73; }
.share-btn { display: flex; align-items: center; justify-content: center; gap: 12rpx; width: 100%; padding: 18rpx 0; line-height: 1.4; background: linear-gradient(135deg, var(--accent-gold), #8E4F27); color: var(--bg-card); font-size: var(--fs-28); border: none; border-radius: 999rpx; box-shadow: 0 14rpx 28rpx -16rpx rgba(142,79,39,0.9); }
.share-btn::after { border: none; }
.sb-ico { font-size: var(--fs-28); }
/* 结果页第二个换锚点入口：锚点卡里的「换一个」滚上去就看不到了 */
.reselect-link { display: inline-flex; align-items: center; gap: 6rpx; margin-top: 20rpx; padding: 8rpx 6rpx; font-size: var(--fs-22); color: var(--muted); }
.rl-arrow { font-size: var(--fs-26); opacity: 0.75; }

/* 回顶：内容最长 2400px，固定在自定义 tabBar 之上 */
.fab { position: fixed; right: 26rpx; bottom: calc(150rpx + env(safe-area-inset-bottom)); z-index: 20; width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(252,249,242,0.96); border: 1rpx solid var(--line); box-shadow: 0 12rpx 28rpx -12rpx rgba(61,46,31,0.6); }
.fab-arrow { width: 18rpx; height: 18rpx; border-left: 3rpx solid var(--china-d); border-top: 3rpx solid var(--china-d); transform: rotate(45deg) translate(3rpx, 3rpx); }

/* 本页不是 tabBar 页，无底栏；仅保留普通底部留白 48rpx + 安全区 */
.bottom-spacer { height: calc(48rpx + env(safe-area-inset-bottom)); }

/* ── 长按浮层 ── */
.pop-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 50; background: rgba(30,22,14,0.55); display: flex; align-items: flex-end; }
.pop-sheet { position: relative; width: 100%; max-height: 82vh; box-sizing: border-box; overflow: hidden; padding: 12rpx 40rpx calc(32rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg, #FDFAF4, var(--bg-primary)); border-radius: 36rpx 36rpx 0 0; box-shadow: 0 -20rpx 60rpx rgba(0,0,0,0.24); display: flex; flex-direction: column; }
.pop-sheet::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 6rpx; background: linear-gradient(90deg, var(--china), #D9A566, var(--world)); }
.pop-grip { width: 72rpx; height: 8rpx; border-radius: 999rpx; background: #D8CBB2; margin: 12rpx auto 18rpx; }
.pop-head { display: flex; align-items: center; justify-content: space-between; }
.pop-kind { display: flex; align-items: center; gap: 10rpx; padding: 6rpx 20rpx; border-radius: 999rpx; font-size: 21rpx; font-weight: 500; letter-spacing: 1rpx; }
.pk-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: currentColor; opacity: 0.75; }
.pop-kind.k-figure { color: var(--bg-card); background: var(--china-d); }
.pop-kind.k-event { color: var(--bg-card); background: var(--world-d); }
.pop-close { width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; font-size: var(--fs-28); color: var(--muted); border-radius: 50%; }
.pop-close:active { background: rgba(61,46,31,0.08); }
.pop-title { margin-top: 16rpx; font-size: 42rpx; font-weight: 600; color: var(--ink); font-family: "Songti SC", "STSong", serif; line-height: 1.35; }
.pop-sub { margin-top: 10rpx; font-size: 23rpx; color: var(--muted); line-height: 1.55; }
.pop-divider { margin-top: 20rpx; height: 2rpx; background: linear-gradient(90deg, var(--china), rgba(181,113,58,0)); opacity: 0.4; }
.pop-loading { display: flex; align-items: center; gap: 12rpx; margin-top: 20rpx; font-size: 25rpx; color: #9A8C73; }
.pl-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--china); animation: blink 1s ease-in-out infinite; }
@keyframes blink { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }
.pop-body { margin-top: 18rpx; max-height: 42vh; overflow-y: auto; font-size: 27rpx; color: #4A3C2B; line-height: 1.85; white-space: pre-line; }
.pop-impact { margin-top: 20rpx; padding: 16rpx 18rpx; background: rgba(181,113,58,0.08); border-left: 5rpx solid var(--china); border-radius: 0 14rpx 14rpx 0; }
.pop-impact-label { margin-bottom: 6rpx; font-size: var(--fs-20); color: var(--china-d); font-weight: 600; letter-spacing: 2rpx; }
.pop-impact-text { font-size: var(--fs-24); color: var(--ink2); line-height: 1.7; white-space: pre-line; }
.pop-btn { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 28rpx; padding: 22rpx 0; background: linear-gradient(135deg, var(--accent-gold), #8E4F27); color: var(--bg-card); border-radius: 999rpx; font-size: var(--fs-28); box-shadow: 0 12rpx 24rpx -14rpx rgba(142,79,39,0.9); }
.pop-btn:active { opacity: 0.88; }
.pb-arrow { font-size: var(--fs-30); }
.pop-foot-hint { margin-top: 22rpx; text-align: center; font-size: var(--fs-20); color: #A2937A; }
