/* 单条气泡引导：只描边 + 卡片，不压暗、不拦截页面。 */

.gb-ring {
  position: fixed;
  z-index: 9988;
  box-sizing: border-box;
  border: 3rpx solid #8f5326;
  border-radius: 14rpx;
  box-shadow: 0 0 0 6rpx rgba(181, 113, 58, 0.14);
  pointer-events: none;
}

.gb-card {
  position: fixed;
  z-index: 9989;
  left: 24px;
  right: 24px;
  box-sizing: border-box;
  padding: 28rpx 32rpx;
  background: #fbf7ef;
  border: 2rpx solid rgba(181, 113, 58, 0.24);
  border-radius: 20rpx;
  box-shadow: 0 16rpx 48rpx rgba(23, 18, 14, 0.18);
}

.gb-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gb-title {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #3d2e1f;
}

.gb-close {
  flex-shrink: 0;
  min-width: 96rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin-left: 16rpx;
  text-align: right;
  font-size: 26rpx;
  color: #8f5326;
}

.gb-hover {
  opacity: 0.7;
}

.gb-body {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #4a3826;
}

.gb-tip {
  margin-top: 14rpx;
  padding-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-muted);
  border-top: 2rpx solid rgba(61, 46, 31, 0.08);
}
