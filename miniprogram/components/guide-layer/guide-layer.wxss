/* tabBar 静态复刻：与真实 tabBar 同尺寸（50px + 安全区），只作讲解用。
   几何由 JS 给出（left/top/width/height），四边完整落在屏幕内；
   自身不再画边框——外框交给 .gl-tabframe 单独一层，
   这样边框不会被这里的背景/阴影弱化，也不会被屏幕底部裁掉。 */
.gl-tabbar {
  position: absolute;
  display: flex;
  align-items: stretch;
  box-sizing: border-box;
  background: #fbf7ef;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 -8rpx 24rpx rgba(23, 18, 14, 0.18);
}

/* tabBar 大外框：金棕描边 + 圆角，渲染在 .gl-tabbar 之后（压在 bar 背景之上） */
.gl-tabframe {
  position: absolute;
  box-sizing: border-box;
  border: 8rpx solid #a05a28;
  border-radius: 24rpx;
  box-shadow: 0 0 0 2rpx rgba(251, 247, 239, 0.9), 0 8rpx 32rpx rgba(23, 18, 14, 0.45);
  pointer-events: none;
  z-index: 4;
}

.gl-tb {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 8rpx;
}

.gl-tb-glyph {
  font-size: 32rpx;
  line-height: 1;
  color: #75654f;
}

.gl-tb-t {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #75654f;
}

