/* 全屏分步引导：遮罩挖孔 + 卡片。字号均为偶数 rpx，未设置 letter-spacing。 */

.gl-root {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9990;
}

.gl-block {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

/* tabBar 步骤的整屏压暗：该步不挖孔，单独一层压暗页面，
   卡片 / 箭头 / tabBar 复刻 / 外框都渲染在它之后，保证清晰可见 */
.gl-dim {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(23, 18, 14, 0.66);
}

/* 挖孔单独成层：透明 + 巨型投影压暗四周（比四块遮罩更好拼接圆角） */
.gl-hole {
  position: absolute;
  border-radius: 16rpx;
  border: 2rpx solid rgba(201, 139, 79, 0.9);
  box-shadow: 0 0 0 9999px rgba(23, 18, 14, 0.74);
  box-sizing: border-box;
}

/* 子元素描边：只画边，不参与压暗（挖孔已由并集矩形负责） */
.gl-ring {
  position: absolute;
  border: 4rpx solid #c98b4f;
  border-radius: 14rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.gl-card {
  position: absolute;
  left: 24px;
  right: 24px;
  box-sizing: border-box;
  padding: 32rpx;
  /* 实色卡：显式不透明底，遮住后面的时间轴与年表；文字用深棕保证 ≥4.5:1 */
  background-color: #FCF9F2;
  background-image: linear-gradient(#FCF9F2, #FCF9F2);
  color: #3D2E1F;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(23, 18, 14, 0.3);
}

/* 指向目标的三角箭头：旋转 45° 的方块，只留两条边。
   卡片默认在目标下方 → 箭头朝上；空间不足翻到上方 → 箭头朝下。
   left 由 JS 按目标中心算出（px），这里只负责把方块对准该点。
   尺寸 36rpx（≈18px，对角宽 25px），奶白填充 + 深棕描边：
   在暗遮罩上靠奶白显形，在奶白卡片上靠深棕描边显形，两侧都不会糊掉。 */
.gl-arrow {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  margin-left: -18rpx;
  background: #FCF9F2;
  border: 4rpx solid #3d2e1f;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.35);
  z-index: 5;
}
.gl-arrow-up {
  top: -18rpx;
  border-right: 0;
  border-bottom: 0;
  transform: rotate(45deg);
}
.gl-arrow-down {
  bottom: -18rpx;
  border-left: 0;
  border-top: 0;
  transform: rotate(45deg);
}

/* 静态复刻的搜索范围下拉：与真实 .emp-dropdown 同族配色（深底、金边、圆形字徽）。
   仅作示意，不接管交互。 */
.gl-mock {
  position: absolute;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  background: rgba(45, 40, 40, 0.96);
  border: 2rpx solid rgba(200, 168, 106, 0.45);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.35);
  pointer-events: none;
}

.gl-mock-list {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.gl-mock-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 14rpx 22rpx;
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  color: rgba(255, 246, 225, 0.78);
  font-size: 24rpx;
}

.gl-mock-item-on {
  color: #fff8e8;
  font-weight: 600;
  background: rgba(255, 246, 225, 0.12);
  border-color: rgba(200, 168, 106, 0.55);
}

.gl-mock-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: inherit;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.18);
}

.gl-mock-label {
  line-height: 1.2;
}

.gl-mock-hint {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid rgba(200, 168, 106, 0.25);
  text-align: center;
  font-size: 20rpx;
  line-height: 1.5;
  color: rgba(255, 246, 225, 0.72);
}

/* ---------- 静态复刻：顶部下拉提示条（下拉刷新示意） ---------- */
.gl-mock-pulldown {
  padding: 14rpx 20rpx 16rpx;
  border-radius: 24rpx;
}

.gl-mp-bar {
  width: 96rpx;
  height: 6rpx;
  margin: 0 auto 12rpx;
  border-radius: 996rpx;
  background: rgba(255, 246, 225, 0.32);
}

.gl-mp-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.gl-mp-text {
  font-size: 24rpx;
  line-height: 1.4;
  color: rgba(255, 246, 225, 0.88);
}

/* 向下的长箭头：与卡片三角同族（奶白填充 + 深棕描边 + 阴影）。
   容器高度由 JS 按「提示条底边到卡片顶边」的间距给出；
   动画只做 transform 平移，不参与任何定位计算。 */
.gl-pd-arrow {
  position: absolute;
  left: 50%;
  top: 100%;
  width: 72rpx;
  height: 56px;
  margin-left: -36rpx;
  margin-top: 16rpx;
  animation: gl-pd-bob 1.6s ease-in-out infinite;
}

.gl-pd-stem {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 4rpx;
  width: 12rpx;
  margin-left: -6rpx;
  box-sizing: border-box;
  background: #fbf7ef;
  border: 4rpx solid #3d2e1f;
  border-radius: 996rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.35);
}

/* 箭头头部：两根奶白胶囊拼成 V，顶点在容器底边中点 */
.gl-pd-head {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 72rpx;
  height: 44rpx;
}

.gl-pd-wing {
  position: absolute;
  top: 20rpx;
  width: 40rpx;
  height: 12rpx;
  box-sizing: border-box;
  background: #fbf7ef;
  border: 4rpx solid #3d2e1f;
  border-radius: 996rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.gl-pd-wing-l {
  left: 2rpx;
  transform: rotate(45deg);
}

.gl-pd-wing-r {
  right: 2rpx;
  transform: rotate(-45deg);
}

/* 往下拖的观感：只平移 7px 再回弹，周期 1.6s */
@keyframes gl-pd-bob {
  0% { transform: translateY(0); }
  50% { transform: translateY(14rpx); }
  100% { transform: translateY(0); }
}

/* ---------- 静态复刻：选年份态（平行时空） ----------
   贴分段胶囊下方，结构照页面真实年份态：纪年输入 + 对照按钮 + 快捷锚点。
   深底金边沿用 .gl-mock；输入框与年份牌用页面同族纸色，视觉上像页面被展开。 */
.gl-mock-year {
  padding: 16rpx 20rpx 14rpx;
  border-radius: 24rpx;
}

