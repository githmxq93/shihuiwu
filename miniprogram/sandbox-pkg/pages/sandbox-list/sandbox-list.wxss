/* 沙盘推演 · 战役列表（沿用推演页纸本墨色 token）
   头部深色统计卡 / 搜索 / 时间轴 / 三态收起沿用平行时空对照页的样式与节奏。
   字号一律偶数 rpx；可点区域 ≥88rpx（44px）。 */
page {
  height: 100%;
  background: #cbb897;
}

.sl-page {
  --paper: #efe2c6;
  --card: #fcf9f2;
  --ink: #302417;
  --ink2: #4a3a28;
  --muted: #6e5d48;
  --line: #e4d9c5;
  --china: #b5713a;
  --china-d: #8e4f27;
  position: relative;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 22% 2%, rgba(255, 253, 244, 0.62), transparent 48%),
    radial-gradient(ellipse at 84% 100%, rgba(58, 38, 20, 0.14), transparent 55%),
    #efe2c6;
  color: #302417;
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
}

.sl-paper {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  opacity: 0.5;
  background:
    repeating-linear-gradient(92deg, rgba(58, 40, 22, 0.035) 0, rgba(58, 40, 22, 0.035) 1px, transparent 1px, transparent 4px),
    radial-gradient(ellipse at 16% 84%, rgba(38, 27, 16, 0.13), transparent 52%),
    radial-gradient(ellipse at 94% 10%, rgba(38, 27, 16, 0.09), transparent 46%);
}

/* ── 可收起头部 ──
   高度由 JS 量好后写成定值，收起时 height 由 px 过渡到 0（auto 不能过渡）；
   overflow:hidden 同时作为 BFC 防止 .hero 的 margin 塌陷出去，量出来的高度才准。 */
.sl-headmain {
  position: relative;
  z-index: 41;
  flex: none;
  overflow: hidden;
  transition: height 0.26s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.sl-headmain.is-folded {
  height: 0 !important;
}

/* ── 深色统计卡 ── */
.hero {
  position: relative;
  flex: none;
  margin: 4rpx 32rpx 0;
  padding: 22rpx 24rpx 20rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 92% 0%, rgba(181, 113, 58, 0.32), rgba(181, 113, 58, 0) 55%),
    linear-gradient(135deg, #3b2c1d 0%, #2a1f14 60%, #4a3521 100%);
  box-shadow: 0 28rpx 56rpx -36rpx rgba(59, 44, 29, 0.9);
}
.hero-mark {
  position: absolute;
  right: 12rpx;
  bottom: -28rpx;
  font-size: 140rpx;
  line-height: 1;
  font-family: "Songti SC", "STSong", serif;
  color: rgba(251, 247, 239, 0.06);
  pointer-events: none;
}
.hero-title {
  position: relative;
  z-index: 1;
  font-size: 44rpx;
  font-weight: 600;
  color: #fbf7ef;
  font-family: "Songti SC", "STSong", serif;
  line-height: 1.3;
  letter-spacing: 4rpx;
}
.hero-sub {
  position: relative;
  z-index: 1;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(251, 247, 239, 0.74);
}
.hero-stats {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid rgba(251, 247, 239, 0.14);
}
.hs {
  display: flex;
  align-items: baseline;
}
.hs + .hs {
  margin-left: 22rpx;
  padding-left: 22rpx;
  border-left: 2rpx solid rgba(251, 247, 239, 0.16);
}
.hs-b {
  font-size: 34rpx;
  font-weight: 600;
  color: #fbf7ef;
  font-family: "Songti SC", "STSong", serif;
}
.hs-t {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: rgba(251, 247, 239, 0.72);
}
.hero-dist {
  position: relative;
  z-index: 1;
  display: flex;
  height: 10rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(251, 247, 239, 0.1);
}
.hd-seg {
  flex: 1;
  height: 100%;
  margin-right: 2rpx;
  background: #b5713a;
}
.hd-seg:last-child {
  margin-right: 0;
}

/* ── 搜索 ── */
.filters {
  position: relative;
  z-index: 40;
  flex: none;
  padding: 0 32rpx;
}
.frow {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.sbox {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 0 8rpx 0 16rpx;
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--card);
}
.sbox.focus {
  border-color: rgba(181, 113, 58, 0.72);
  box-shadow: 0 0 0 4rpx rgba(181, 113, 58, 0.1);
}
.sico {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(181, 113, 58, 0.14);
  color: var(--china-d);
  font-size: 22rpx;
}
.sinput {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  margin-left: 12rpx;
  font-size: 26rpx;
  color: var(--ink);
}
.sph {
  color: var(--muted);
  font-size: 24rpx;
}
.sclear {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--muted);
}
.tb-line {
  display: flex;
  justify-content: flex-end;
  padding: 8rpx 0 4rpx;
}
.tb-hint {
  max-width: 620rpx;
  font-size: 20rpx;
  color: var(--muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ── 时间轴（独立一行，才能单独压缩/收成摘要条）── */
.tl {
  position: relative;
  z-index: 35;
  flex: none;
  margin: 10rpx 32rpx 0;
  padding: 12rpx 18rpx 6rpx;
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--card);
  transition: margin 0.24s ease, padding 0.24s ease, box-shadow 0.24s ease;
}
.tl-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tl-cap {
  font-size: 20rpx;
  color: var(--muted);
}
.tl-now {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--china-d);
  font-family: "Songti SC", "STSong", serif;
}
.tl-right {
  display: flex;
  align-items: baseline;
}
.tl-idx {
  margin-right: 10rpx;
  font-size: 20rpx;
  color: var(--muted);
}
.tl-fold {
  display: none;
  font-size: 20rpx;
  color: var(--china-d);
}
.tl-zone {
  height: 96rpx;
  margin-top: 6rpx;
  overflow: hidden;
  transition: height 0.24s ease, margin 0.24s ease;
}
.tl-bars {
  position: relative;
  height: 96rpx;
  transition: transform 0.24s ease;
}

/* 一级收起：吸顶细条，保留游标 / 年份 / 第 x 场，隐藏刻度与图例 */
.tl.compact {
  margin-top: 8rpx;
  padding: 6rpx 18rpx 6rpx;
  box-shadow: 0 10rpx 24rpx -18rpx rgba(59, 44, 29, 0.7);
}
.tl.compact .tl-cap {
  display: none;
}
.tl.compact .tl-zone {
  height: 56rpx;
  margin-top: 2rpx;
}
.tl.compact .tl-bars {
  transform: scaleY(0.58);
  transform-origin: top center;
}
.tl.compact .tl-ticks,
.tl.compact .tl-legend {
  display: none;
}

/* 二级收起：88rpx 摘要条（年份 · 第 x 场），点击整条展开 */
.tl.mini {
  margin-top: 6rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 24rpx -18rpx rgba(59, 44, 29, 0.7);
}
.tl.mini .tl-cap,
.tl.mini .tl-zone,
.tl.mini .tl-ticks,
.tl.mini .tl-legend {
  display: none;
}
.tl.mini .tl-head {
  height: 88rpx;
}
.tl.mini .tl-fold {
  display: block;
  flex: none;
  margin-left: 16rpx;
  font-size: 20rpx;
  color: var(--china-d);
}
.tl-mini {
  display: none;
}
.tl.mini .tl-mini {
  display: block;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--china-d);
  font-family: "Songti SC", "STSong", serif;
}

/* 密度柱：纯 view，底部对齐，柱高由 JS 按阶段数预计算后写成 rpx 内联样式 */
.tl-b {
  position: absolute;
  bottom: 0;
  transform: translateX(-50%);
  border-radius: 2rpx 2rpx 0 0;
  background: var(--china);
  opacity: 0.72;
}
.tl-thumb {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 3rpx;
  margin-left: -2rpx;
  background: #2a1f14;
  border-radius: 2rpx;
  pointer-events: none;
}
.tl-thumb::after {
  content: "";
  position: absolute;
  left: -6rpx;
  top: -2rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #2a1f14;
  box-shadow: 0 0 0 4rpx rgba(251, 247, 239, 0.9);
}
.tl-hit {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 3;
}
.tl-ticks {
  position: relative;
  height: 28rpx;
  margin-top: 2rpx;
}
.tk {
  position: absolute;
  top: 0;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: var(--muted);
  white-space: nowrap;
}
.tk:first-child {
  transform: none;
}
.tk:last-child {
  transform: translateX(-100%);
}
.tl-legend {
  display: flex;
  align-items: center;
  margin-top: 2rpx;
}
.lg {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: var(--muted);
}
.lg::before {
  content: "";
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  margin-right: 8rpx;
  background: var(--china);
}

/* ── 列表主体 ── */
.sl-body {
  position: relative;
  z-index: 1;
  flex: 1 1 0;
  height: 0;
  min-height: 0;
}

.sl-list {
  padding: 8rpx 32rpx 0;
}

.sl-card {
  display: flex;
  align-items: center;
  min-height: 152rpx;
  margin-bottom: 16rpx;
  padding: 24rpx 24rpx;
  box-sizing: border-box;
  background: #f4ead4;
  border: 2rpx solid rgba(23, 17, 12, 0.18);
  border-radius: 6rpx;
  box-shadow: 0 8rpx 20rpx -18rpx rgba(31, 21, 12, 0.6);
}
.sl-card-hover {
  background: #f8f0de;
  border-color: rgba(156, 61, 36, 0.42);
}
/* 时间轴指向的那一场：底色比常态深一档（同色系加深，不用高亮黄），
   拖动与点击时间轴都会同步 activeId，因此这里只需一个类。 */
.sl-card.is-on {
  background: #e5d1a6;
  border-color: rgba(142, 79, 39, 0.55);
  box-shadow: 0 8rpx 20rpx -18rpx rgba(31, 21, 12, 0.7), 0 0 0 4rpx rgba(142, 79, 39, 0.14);
}

.sl-no {
  flex: none;
  width: 64rpx;
  font-family: Georgia, serif;
  font-size: 28rpx;
  line-height: 1;
  color: #9c3d24;
  letter-spacing: 2rpx;
  border-right: 2rpx solid rgba(156, 61, 36, 0.28);
  padding-right: 16rpx;
  margin-right: 20rpx;
}

.sl-main {
  flex: 1;
  min-width: 0;
}

.sl-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.sl-name {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #140e09;
}
.sl-phase {
  flex: none;
  margin-left: 12rpx;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: #8c3520;
  border: 2rpx solid rgba(156, 61, 36, 0.36);
  border-radius: 2rpx;
  padding: 2rpx 8rpx;
  background: rgba(156, 61, 36, 0.07);
}

.sl-meta {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #6b5844;
}
.sl-years {
  font-family: Georgia, serif;
  color: #8c3520;
}
.sl-dot {
  margin: 0 6rpx;
  color: #a3907a;
}
.sl-period {
  color: #6b5844;
}

.sl-hook {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  letter-spacing: 0.5rpx;
  color: #5c4a36;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.sl-chev {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  margin-left: 16rpx;
  border-top: 3rpx solid #9c8a6b;
  border-right: 3rpx solid #9c8a6b;
  transform: rotate(45deg);
}

.none {
  margin: 18rpx 0 0;
  padding: 36rpx 26rpx;
  border: 2rpx dashed rgba(23, 17, 12, 0.2);
  border-radius: 16rpx;
  text-align: center;
  background: #f4ead4;
}
.none-t {
  display: block;
  font-size: 28rpx;
  color: #302417;
}
.none-s {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #6b5844;
}

.sl-foot {
  padding: 16rpx 32rpx 0;
  text-align: center;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #8a7357;
}

.sl-safe {
  height: 48rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ── 拖动预览卡：按住时间轴时浮在底部，不参与列表布局 ── */
.pv {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 70;
  box-sizing: border-box;
  padding: 18rpx 22rpx 16rpx;
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  background: #fffdf8;
  box-shadow: 0 18rpx 44rpx -20rpx rgba(42, 31, 20, 0.55);
  pointer-events: none;
}
.pv-hd {
  display: flex;
  align-items: baseline;
}
.pv-year {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  font-family: "Songti SC", "STSong", serif;
}
.pv-idx {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: var(--muted);
}
.pv-title {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pv-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pv-foot {
  display: block;
  margin-top: 10rpx;
  font-size: 18rpx;
  color: var(--muted);
}
