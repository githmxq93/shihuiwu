/* 沙盘推演 · 安史之乱（纸本墨色，尺寸按原型 375px 等比折算为 rpx×2） */
page {
  height: 100%;
  background: #cbb897;
}

.sb-page {
  position: relative;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background:
    radial-gradient(ellipse at 22% 2%, rgba(255, 253, 244, 0.62), transparent 48%),
    radial-gradient(ellipse at 84% 100%, rgba(58, 38, 20, 0.14), transparent 55%),
    #efe2c6;
  color: #302417;
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
}

/* 纸纹：极淡的竖纹 + 两处皴擦 */
.sb-paper {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  opacity: 0.5;
  background:
    repeating-linear-gradient(92deg, rgba(58, 40, 22, 0.035) 0, rgba(58, 40, 22, 0.035) 1px, transparent 1px, transparent 4px),
    radial-gradient(ellipse at 16% 84%, rgba(38, 27, 16, 0.13), transparent 52%),
    radial-gradient(ellipse at 94% 10%, rgba(38, 27, 16, 0.09), transparent 46%);
}

/* ============ 顶部 ============ */
.sb-top {
  position: relative;
  z-index: 2;
  flex: none;
  padding: 0 32rpx 8rpx;
}

.sb-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
}

.sb-back {
  width: 88rpx;
  height: 88rpx;
  margin-left: -20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sb-back-i {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 64rpx;
  line-height: 1;
  color: #302417;
  margin-top: -8rpx;
}
.sb-back-hover {
  opacity: 0.55;
}

.sb-bar-k {
  flex: 1;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 18rpx;
  letter-spacing: 8rpx;
  color: #9c3d24;
  font-weight: 700;
}

.sb-year {
  display: flex;
  align-items: baseline;
}
.sb-year-v {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 36rpx;
  font-weight: 700;
  color: #9c3d24;
}
.sb-year-u {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: #8a7357;
  margin-left: 4rpx;
}

.sb-hd {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-bottom: 4rpx;
}
.sb-hd-l {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.sb-title {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 54rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #140e09;
}
.sb-sub {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #5c4a36;
  margin-top: 4rpx;
}
.sb-year {
  flex: none;
  display: flex;
  align-items: baseline;
  margin-left: 16rpx;
  padding-bottom: 6rpx;
}

/* ============ 时间轴 ============ */
.sb-tl {
  position: relative;
  z-index: 2;
  flex: none;
  padding: 8rpx 32rpx 0;
}

.sb-tl-row {
  display: flex;
  align-items: center;
}

.sb-play {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border: 3rpx solid #9c3d24;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s, transform 0.12s;
}
.sb-play.is-playing {
  background: #9c3d24;
}
.sb-play-hover {
  transform: scale(0.94);
}
.sb-ic-play {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-left: 26rpx solid #9c3d24;
  border-top: 15rpx solid transparent;
  border-bottom: 15rpx solid transparent;
}
.sb-play.is-playing .sb-ic-play {
  border-left-color: #f7eeda;
}
.sb-ic-pause {
  display: flex;
  align-items: center;
}
.sb-ic-bar {
  width: 10rpx;
  height: 30rpx;
  background: #f7eeda;
  margin: 0 5rpx;
}

.sb-track {
  position: relative;
  flex: 1;
  height: 88rpx;
  margin-left: 20rpx;
  display: flex;
  align-items: center;
}

.sb-rail {
  position: absolute;
  left: 0;
  right: 0;
  height: 8rpx;
  background: rgba(23, 17, 12, 0.16);
  overflow: hidden;
}
.sb-rail-fill {
  height: 100%;
  background: linear-gradient(90deg, #302417, #9c3d24);
}

.sb-seg {
  position: absolute;
  top: 38rpx;
  width: 4rpx;
  height: 12rpx;
  background: rgba(239, 226, 198, 0.95);
}

.sb-thumb {
  position: absolute;
  top: 27rpx;
  width: 20rpx;
  height: 34rpx;
  border-radius: 2rpx;
  background: #f7eeda;
  border: 3rpx solid #231a10;
  transform: translateX(-50%);
  box-shadow: 0 4rpx 10rpx rgba(20, 14, 8, 0.35);
  pointer-events: none;
  transition: width 0.12s, height 0.12s, top 0.12s;
}
.sb-thumb.is-drag {
  width: 26rpx;
  height: 42rpx;
  top: 23rpx;
}

/* 播放时用 80ms 线性插值把 12.5fps 的进度刷新连成连续运动；拖动时不插值，手指即位置 */
.sb-tl.is-play .sb-thumb {
  transition: left 0.08s linear, width 0.12s, height 0.12s, top 0.12s;
}
.sb-tl.is-play .sb-rail-fill {
  transition: width 0.08s linear;
}

/* 拖动浮签 */
.sb-tip {
  position: absolute;
  bottom: 88rpx;
  padding: 6rpx 14rpx;
  background: #f7eeda;
  border: 2rpx solid rgba(156, 61, 36, 0.5);
  border-radius: 4rpx;
  box-shadow: 0 6rpx 16rpx -8rpx rgba(20, 14, 8, 0.5);
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: #9c3d24;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.16s;
}
.sb-tip.is-on {
  opacity: 1;
}

.sb-labels {
  display: flex;
  margin-top: 4rpx;
}
.sb-lab {
  flex: 1;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-top: 2rpx solid rgba(23, 17, 12, 0.07);
}
.sb-lab-hover {
  background: rgba(156, 61, 36, 0.06);
}
.sb-lab-n {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 16rpx;
  letter-spacing: 1rpx;
  color: #8a7357;
}
.sb-lab-t {
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: #5c4a36;
  margin-top: 2rpx;
}
.sb-lab.is-on .sb-lab-n,
.sb-lab.is-on .sb-lab-t {
  color: #9c3d24;
  font-weight: 700;
}

/* ============ 地图 ============ */
.sb-map {
  position: relative;
  z-index: 1;
  flex: 1.3 1 0;
  min-height: 300rpx;
  margin: 6rpx 16rpx 0;
  border: 2rpx solid rgba(23, 17, 12, 0.18);
  overflow: hidden;
  background:
    radial-gradient(ellipse at 30% 10%, rgba(255, 253, 244, 0.5), transparent 55%),
    #efe2c6;
}
.sb-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.sb-note {
  position: relative;
  z-index: 1;
  flex: none;
  padding: 8rpx 24rpx 0;
  font-size: 16rpx;
  line-height: 1.6;
  letter-spacing: 1rpx;
  color: #5c4a36;
  opacity: 0.9;
}

.sb-focus {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  background: rgba(244, 234, 212, 0.84);
  border: 2rpx solid rgba(156, 61, 36, 0.28);
  pointer-events: none;
}
.sb-focus-k {
  font-size: 14rpx;
  letter-spacing: 1rpx;
  color: #8a7357;
  padding-right: 8rpx;
  border-right: 2rpx solid rgba(156, 61, 36, 0.3);
}
.sb-focus-v {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 18rpx;
  color: #9c3d24;
  margin-left: 8rpx;
}
.sb-focus.is-end .sb-focus-v {
  font-weight: 700;
}

/* 终局印 */
.sb-seal {
  position: absolute;
  right: 36rpx;
  top: 36rpx;
  width: 128rpx;
  height: 128rpx;
  border: 4rpx solid #9c3d24;
  border-radius: 4rpx;
  background: rgba(246, 238, 220, 0.9);
  display: flex;
  flex-wrap: wrap;
  align-content: center;
  justify-content: center;
  transform: rotate(-9deg) scale(0.6);
  opacity: 0;
  transition: opacity 0.3s, transform 0.3s;
  pointer-events: none;
}
.sb-seal.is-on {
  opacity: 0.94;
  transform: rotate(-9deg) scale(1);
}
.sb-seal-c {
  width: 50%;
  text-align: center;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 40rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #9c3d24;
}
.sb-seal-s {
  width: 100%;
  text-align: center;
  font-size: 14rpx;
  letter-spacing: 1rpx;
  color: #8c3520;
  margin-top: 2rpx;
}

/* ============ 阶段卡 ============ */
.sb-card {
  position: relative;
  z-index: 1;
  flex: 1 1 0;
  height: 0;
  min-height: 0;
  margin: 8rpx 16rpx 0;
}
.sb-card-in {
  margin-bottom: 12rpx;
  padding: 20rpx 24rpx 24rpx;
  background: #f4ead4;
  border: 2rpx solid rgba(23, 17, 12, 0.18);
  border-radius: 4rpx;
  box-shadow: 0 -10rpx 26rpx -22rpx rgba(31, 21, 12, 0.6);
}

.sb-card-hd {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.sb-card-hl {
  flex: 1;
  min-width: 0;
}
.sb-kicker {
  display: block;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  font-weight: 700;
  color: #8c3520;
}
.sb-ctitle {
  display: block;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 36rpx;
  line-height: 1.3;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #140e09;
  margin-top: 2rpx;
}
.sb-stamp {
  flex: none;
  margin-left: 16rpx;
  padding: 4rpx 10rpx;
  border: 3rpx solid #9c3d24;
  border-radius: 2rpx;
  background: rgba(156, 61, 36, 0.1);
  color: #9c3d24;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 20rpx;
  line-height: 1.1;
  letter-spacing: 2rpx;
  font-weight: 700;
  transform: rotate(-4deg);
}

/* 兵力条 */
.sb-force {
  margin-top: 12rpx;
}
.sb-fr {
  position: relative;
  display: flex;
  align-items: center;
  height: 36rpx;
  font-size: 18rpx;
  line-height: 1;
}
.sb-fr-l {
  flex: none;
  width: 132rpx;
  color: #6b5844;
  white-space: nowrap;
  overflow: hidden;
}
.sb-fr-t {
  flex: 1;
  height: 12rpx;
  background: rgba(23, 17, 12, 0.07);
  border-radius: 2rpx;
  overflow: hidden;
  margin: 0 10rpx;
}
.sb-fr-i {
  display: block;
  height: 100%;
  border-radius: 2rpx;
  background: linear-gradient(90deg, #2b5262, #9c3d24);
}
.sb-fr-i.is-unk {
  background: repeating-linear-gradient(45deg, rgba(23, 17, 12, 0.28) 0, rgba(23, 17, 12, 0.28) 4rpx, transparent 4rpx, transparent 10rpx);
}
/* 减员：条尾渐隐，不齐断 */
.sb-fr-i.is-cut {
  background: linear-gradient(90deg, #2b5262 0%, #9c3d24 70%, rgba(156, 61, 36, 0.35) 91%, rgba(156, 61, 36, 0) 100%);
}
.sb-fr-i.is-unk.is-cut {
  opacity: 0.55;
}
.sb-fr-v {
  position: relative;
  flex: none;
  width: 132rpx;
  text-align: right;
  color: #1b140d;
  white-space: nowrap;
}
.sb-fr-k {
  flex: none;
  width: 44rpx;
  margin-left: 8rpx;
  text-align: center;
  font-size: 14rpx;
  line-height: 1.5;
  border-radius: 2rpx;
  letter-spacing: 1rpx;
}
.sb-fr-k--shi {
  background: rgba(43, 82, 98, 0.09);
  color: #33505a;
  border: 2rpx solid rgba(43, 82, 98, 0.3);
}
.sb-fr-k--tui {
  background: rgba(156, 61, 36, 0.06);
  color: #8c5a43;
  border: 2rpx dashed rgba(156, 61, 36, 0.36);
}
.sb-fr-k--none {
  background: rgba(23, 17, 12, 0.035);
  color: #7a6954;
  border: 2rpx solid rgba(23, 17, 12, 0.16);
}
.sb-fr-cut {
  position: absolute;
  right: 188rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 14rpx;
  line-height: 1.4;
  padding: 0 4rpx;
  border-radius: 2rpx;
  letter-spacing: 1rpx;
  color: #8c3520;
  border: 2rpx solid rgba(156, 61, 36, 0.42);
  background: rgba(246, 238, 220, 0.86);
  white-space: nowrap;
}
.sb-force-n {
  font-size: 14rpx;
  line-height: 1.5;
  color: #8a7357;
  letter-spacing: 1rpx;
  margin-top: 2rpx;
}
.sb-force-em {
  color: #8c3520;
}

/* 事件四栏 */
.sb-evs {
  display: flex;
  margin-top: 12rpx;
  border-top: 2rpx solid rgba(23, 17, 12, 0.14);
  border-bottom: 2rpx solid rgba(23, 17, 12, 0.14);
}
.sb-ev {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 10rpx 8rpx 10rpx 12rpx;
  border-left: 2rpx solid rgba(23, 17, 12, 0.1);
  opacity: 0.94;
  transition: background 0.2s, opacity 0.2s;
}
.sb-ev:first-child {
  border-left: 0;
  padding-left: 2rpx;
}
.sb-ev.is-read {
  opacity: 0.4;
}
.sb-ev.is-on {
  opacity: 1;
  background: linear-gradient(90deg, rgba(156, 61, 36, 0.19), rgba(156, 61, 36, 0.02));
  box-shadow: inset 6rpx 0 0 #9c3d24;
}
.sb-ev-h {
  display: flex;
  align-items: baseline;
}
.sb-ev-y {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  margin-right: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14rpx;
  line-height: 1;
  font-weight: 700;
  color: #8a7357;
  border: 2rpx solid rgba(156, 61, 36, 0.32);
  border-radius: 2rpx;
}
.sb-ev.is-on .sb-ev-y {
  background: #9c3d24;
  border-color: #9c3d24;
  color: #f7eeda;
}
.sb-ev-t {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 16rpx;
  color: #8a7357;
  white-space: nowrap;
}
.sb-ev.is-on .sb-ev-t {
  color: #9c3d24;
}
.sb-ev-b {
  font-size: 16rpx;
  font-weight: 700;
  color: #8c3520;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sb-ev-x {
  font-size: 16rpx;
  line-height: 1.35;
  color: #3a2b1c;
  margin-top: 2rpx;
}
.sb-ev.is-on .sb-ev-x {
  color: #1f170f;
  font-weight: 600;
}

/* 转折 / 因果 / 出处 */
.sb-turn {
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  border-left: 6rpx solid #9c3d24;
  border-radius: 0 8rpx 8rpx 0;
  background: linear-gradient(90deg, rgba(156, 61, 36, 0.11), rgba(156, 61, 36, 0.015));
}
.sb-row-k {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: #9c3d24;
  font-weight: 600;
}
.sb-row-v {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #2e2318;
}
.sb-why {
  margin-top: 10rpx;
  padding-left: 12rpx;
  border-left: 4rpx solid rgba(156, 61, 36, 0.3);
}
.sb-why .sb-row-k {
  color: #8c3520;
  font-size: 16rpx;
}
.sb-why .sb-row-v {
  font-size: 20rpx;
  text-align: justify;
}

.sb-src {
  display: flex;
  align-items: flex-start;
  margin-top: 8rpx;
}
.sb-src-k {
  flex: none;
  margin-right: 8rpx;
  padding: 0 6rpx;
  font-size: 16rpx;
  line-height: 1.5;
  color: #9c3d24;
  border: 2rpx solid rgba(156, 61, 36, 0.32);
  border-radius: 2rpx;
  background: rgba(156, 61, 36, 0.04);
}
.sb-src-v {
  flex: 1;
  font-size: 16rpx;
  line-height: 1.5;
  color: #7b6a54;
}

/* 图例 */
.sb-legend {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid rgba(23, 17, 12, 0.3);
}
.sb-lg {
  display: flex;
  align-items: center;
  font-size: 18rpx;
  color: #5c4a36;
}
.sb-lg-flag {
  width: 0;
  height: 0;
  margin-right: 8rpx;
  border-left: 20rpx solid #2b5262;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
}
.sb-lg-flip {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #9c3d24;
  box-shadow: 0 0 0 4rpx rgba(156, 61, 36, 0.16);
}
.sb-lg-dash {
  width: 30rpx;
  height: 0;
  margin-right: 8rpx;
  border-top: 3rpx dashed #6d655a;
}
