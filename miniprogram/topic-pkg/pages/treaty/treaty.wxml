<view class="tt-page">
  <nav-bar title="历代条约" safeAreaTop="{{safeAreaTop}}" />

  <!-- 时期导航：scroll-view 内 position:sticky 不生效 ⇒ fixed 挂在 nav 下方，
       由 .page-scroll 的 padding-top 给内容让位 -->
  <view class="era-nav" style="top:{{navH}}px">
    <scroll-view class="era-nav-scroll" scroll-x="{{true}}" enhanced="{{true}}" bounces="{{false}}" show-scrollbar="{{false}}">
      <view class="era-nav-inner">
        <view
          wx:for="{{eraTabs}}"
          wx:key="key"
          class="era-tab {{activeKey === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onTapEra"
          hover-class="era-tab-hover"
        >
          <text class="era-tab-name">{{item.name}}</text>
          <text class="era-tab-count">{{item.count}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <scroll-view
    class="page-scroll"
    style="padding-top:{{navH + 52}}px"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    bounces="{{false}}"
    show-scrollbar="{{false}}"
    scroll-into-view="{{scrollToId}}"
    scroll-with-animation="{{true}}"
    bindscroll="onScroll"
  >
    <view id="tt-top" class="hero">
      <view class="hero-badge">条约典章</view>
      <view class="hero-title">历代<text class="hero-title-accent">条约</text></view>
      <view class="hero-subtitle">783 — 2020 · 从清水会盟到 RCEP</view>
      <view class="hero-intro">从唐蕃会盟的一纸盟约，到晚清被迫签订的《南京条约》《马关条约》，再到建国后以平等姿态划定边界、加入国际公约——千余年间，条约见证了对外关系的沧桑巨变。下面按时期切换，每一条条约都附一段始末。</view>

      <view class="hero-stats">
        <block wx:for="{{stats}}" wx:key="label" wx:for-index="si">
          <view class="stat-item">
            <text class="stat-num">{{item.value}}</text>
            <text class="stat-label">{{item.label}}</text>
          </view>
          <view wx:if="{{si < stats.length - 1}}" class="stat-divider"></view>
        </block>
      </view>
    </view>

    <view class="error-retry" wx:if="{{loadFailed}}">
      <view class="error-retry-text">数据加载失败，请检查网络后重试</view>
      <view class="error-retry-btn" bindtap="onRetry">重新加载</view>
    </view>

    <!-- 加载中骨架：弱网下内容区尚无数据，若直接渲染空数组就是整片空白 -->
    <view class="skeleton-wrap" wx:elif="{{loading}}">
      <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="skeleton-card">
        <view class="skeleton-line skeleton-line-title"></view>
        <view class="skeleton-line"></view>
        <view class="skeleton-line skeleton-line-short"></view>
      </view>
      <view class="skeleton-hint">正在加载…</view>
    </view>

    <!-- 请求成功但内容为空（区别于加载失败） -->
    <view class="sk-empty" wx:elif="{{isEmpty}}">
      <view class="sk-empty-icon">卷</view>
      <view class="sk-empty-text">暂无相关内容</view>
    </view>

    <view wx:else>
      <!-- 切换时期后滚到这里：恰好落在固定导航下方 -->
      <view id="tt-content" class="content-anchor"></view>

      <view class="content">
        <!-- 当前时期小结：内凹凹槽 -->
        <view class="era-panel">
          <view class="ep-head">
            <text class="ep-index">{{view.indexText}}</text>
            <view class="ep-title">
              <text class="ep-name">{{view.name}}</text>
              <text class="ep-years">{{view.years}}</text>
            </view>
            <text class="ep-total">{{view.count}} 条</text>
          </view>

          <view wx:if="{{view.intro}}" class="ep-intro">{{view.intro}}</view>

          <view wx:if="{{view.count > 0}}" class="ep-chips">
            <view wx:if="{{view.unequal > 0}}" class="ep-chip unequal">
              <text class="ep-chip-num">{{view.unequal}}</text>
              <text class="ep-chip-label">不平等</text>
            </view>
            <view wx:if="{{view.equal > 0}}" class="ep-chip equal">
              <text class="ep-chip-num">{{view.equal}}</text>
              <text class="ep-chip-label">平等与多边</text>
            </view>
          </view>
        </view>

        <view wx:if="{{view.isEmpty}}" class="era-empty">此时期未留下正式双边条约，以朝贡、册封、会盟等形式维持对外关系</view>

        <!-- 条约卡片 -->
        <view class="tt-list">
          <view wx:for="{{view.treaties}}" wx:for-item="t" wx:key="name" class="tt-card">
            <view class="tt-head">
              <text class="tt-name">{{t.name}}</text>
              <text class="tt-nature {{t.natureClass}}">{{t.nature}}</text>
            </view>

            <view class="tt-meta">
              <text class="tt-time">{{t.time}}</text>
              <view class="tt-parties">
                <text class="tt-parties-label">缔约</text>
                <text class="tt-parties-text">{{t.parties}}</text>
              </view>
            </view>

            <view class="tt-summary">{{t.content}}</view>

            <!-- 条约始末：左侧朱砂细条，与「概要」形成两种层级 -->
            <view wx:if="{{t.intro}}" class="tt-intro">
              <view class="tt-intro-label">条约始末</view>
              <view class="tt-intro-text">{{t.intro}}</view>
            </view>
          </view>
        </view>

        <view class="footnote">
          <view class="footnote-icon css-star"></view>
          <view class="footnote-text">从「城下之盟」的屈辱，到平等相待的从容，一部条约史，即是一部国家命运的浮沉史。铭记那些不平等条约，是为了不忘落后挨打的教训；珍视今日的平等交往，是为了续写民族复兴的新篇。</view>
        </view>
      </view>
    </view>

    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- 回到顶部 -->
  <view wx:if="{{showTop}}" class="to-top" bindtap="onToTop" hover-class="to-top-hover">
    <view class="to-top-arrow"></view>
  </view>
</view>
