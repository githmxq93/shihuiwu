/* 博物馆暖调（纸色底、墨棕字、朱砂/赭金强调）
 *
 * 本版按 _design/remember/d-refine.html 落地（2026-11-13）：
 *   1) 顶部三行深色头，口径同大事年表 / 世系页（同一组渐变 + 暖赭光晕 + 织物纹理）；
 *   2) 头下 37px 段导航，5 项对 5 个 section，滚动时高亮；
 *   3) 原 hero 的导语 / 8.15 高亮 / 注记压成 .lead；
 *   4) 对比度、字距、小字、层级、卡片语言按稿子最终值统一：
 *      #8f7c63 → #75654f（5.27:1）、#b5713a 小字 → #8f5326（5.72:1）、
 *      全页 letter-spacing:0、正文小字 24rpx、标题 36/30/28rpx 三级。
 *
 * 布局（2026-11-13 三次调整）：页面滚动 + 头部常驻压缩。
 * 深色头与段导航包在 .hd-stack 里，整块 fixed 钉在系统导航栏下沿（top = navH，内联）；
 * 下滑过阈值后头从 93px 压到 44px（两行小字淡出、标题缩小、留白收紧），段导航随之上移。
 * 选 fixed 不选 sticky：sticky 仍在文档流里，压缩时高度变小会把正文往上顶一次（滚动中可见跳变）；
 * fixed 覆盖在正文上，压缩只是多露出正文。代价是页面要垫一块等高占位 .hd-space，
 * 与同包 treaty 页「fixed 导航 + 垫高」是同一套做法。
 */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 50% 0%, rgba(166, 59, 42, 0.20) 0%, transparent 45%),
    radial-gradient(circle at 10% 30%, rgba(181, 113, 58, 0.08) 0%, transparent 30%),
    radial-gradient(circle at 90% 70%, rgba(166, 59, 42, 0.12) 0%, transparent 38%),
    linear-gradient(180deg, var(--bg-deep) 0%, #e6d9c0 45%, var(--bg-deep) 100%);
  color: var(--text-primary);
  letter-spacing: 0;
}

/* ===== 常驻头容器（fixed）+ 等高占位 =====
 * 头 186rpx + 段导航 74rpx = 260rpx（130px）；占位恒定，压缩时正文坐标不动。
 * z-index 90 低于 navBar 的 100，深色头永远钻不到系统导航栏下面。
 * 容器底色只为挡住 .hd 下沿圆角缺口（同 lineage 的 .ln-head-wrap）。 */
.hd-stack {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 90;
  background: var(--bg-primary);
}

.hd-space {
  height: 260rpx;
}

/* ===== 深色三行头（展开 186rpx / 压缩 88rpx） =====
 * 两个高度都显式写死，height 过渡才可动画；内容用 flex 纵向居中，
 * 收起小字后标题自动落在剩余空间正中，不需要改 padding。
 * 圆角只在下沿（20rpx），顶部与导航栏相接不露缝；光晕在右上角。 */
.hd {
  position: relative;
  height: 186rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 32rpx;
  transition: height 0.24s ease;
  background:
    radial-gradient(120% 90% at 84% 0%, rgba(207, 138, 75, 0.28), transparent 58%),
    linear-gradient(160deg, var(--head-grad-top) 0%, var(--head-grad-mid) 46%, var(--head-grad-bottom) 100%);
  border-radius: 0 0 20rpx 20rpx;
  box-shadow: 0 10rpx 24rpx -14rpx rgba(30, 20, 12, 0.7);
  overflow: hidden;
}

.hd--compact {
  height: 88rpx;
}

/* 织物纹理：与世系页 .ln-head::before、详情页 .b2-mini::before 同一条 */
.hd::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  opacity: 0.3;
  background: repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 3px);
}

.hd-k {
  position: relative;
  z-index: 1;
  height: 30rpx;
  overflow: hidden;
  font-size: var(--fs-22);
  line-height: 1.3;
  color: rgba(255, 247, 232, 0.64);
  transition: height 0.2s ease, opacity 0.16s ease;
}

.hd-t {
  position: relative;
  z-index: 1;
  margin-top: 6rpx;
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.24;
  color: #fff7e8;
  transition: font-size 0.24s ease;
}

.hd-s {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  height: 30rpx;
  margin-top: 12rpx;
  overflow: hidden;
  line-height: 1;
  transition: height 0.2s ease, margin-top 0.2s ease, opacity 0.16s ease;
}

/* 压缩态：两行小字收成 0 高并淡出，标题 44rpx → 34rpx，整块 93px → 44px */
.hd--compact .hd-k,
.hd--compact .hd-s {
  height: 0;
  opacity: 0;
}

.hd--compact .hd-s {
  margin-top: 0;
}

.hd--compact .hd-t {
  font-size: var(--fs-34);
}

.hd-si {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  white-space: nowrap;
}

.hd-b {
  font-family: Georgia, var(--font-serif);
  font-size: var(--fs-30);
  font-weight: 700;
  color: #e9c79b;
}

.hd-i {
  font-size: var(--fs-22);
  color: rgba(255, 247, 232, 0.66);
}

/* ===== 段导航（37px = 74rpx） =====
 * 不再自己 sticky：已在 fixed 的 .hd-stack 里，头压缩时它跟着上移，天然贴在头下沿。
 * 底色必须不透明（--bg-primary），深色头压缩/展开过程中不会从导航条里透出来；
 * 下沿细线分隔，选中项只换色 + 2px 下划线。 */
.seg {
  display: flex;
  align-items: stretch;
  gap: 4rpx;
  height: 74rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  background: var(--bg-primary);
  border-bottom: 1rpx solid rgba(107, 90, 69, 0.18);
  overflow-x: auto;
  white-space: nowrap;
}

.seg::-webkit-scrollbar {
  display: none;
}

.seg-i {
  flex: none;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  font-size: var(--fs-24);
  line-height: 1.35;
  color: var(--text-muted);
  border-bottom: 4rpx solid transparent;
  box-sizing: border-box;
}

.seg-i-hover {
  color: var(--accent-vermillion);
}

.seg-i.on {
  color: var(--accent-vermillion);
  font-weight: 700;
  border-bottom-color: var(--accent-vermillion);
}

/* ===== 原 hero 压成三块：导语 + 8.15 高亮 + 注记 ===== */
.lead {
  padding: 24rpx 32rpx 0;
}

.lead-p {
  font-size: var(--fs-26);
  line-height: 1.7;
  color: var(--text-muted);
  text-align: justify;
}

.lead-hl-num {
  color: var(--accent-vermillion);
  font-weight: 700;
}

.lead-hl {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  background: rgba(166, 59, 42, 0.06);
  border: 1rpx solid rgba(166, 59, 42, 0.22);
  border-left: 6rpx solid rgba(166, 59, 42, 0.55);
  border-radius: var(--radius);
}

.lead-hl-t {
  font-size: var(--fs-24);
  font-weight: 700;
  color: var(--accent-vermillion);
  margin-bottom: 6rpx;
}

.lead-hl-d {
  font-size: var(--fs-24);
  line-height: 1.65;
  color: var(--text-muted);
}

.lead-note {
  margin-top: 16rpx;
  font-size: var(--fs-24);
  line-height: 1.65;
  color: var(--text-muted);
}

/* ===== 章节 ===== */
.content {
  padding-bottom: 8rpx;
}

.section {
  padding: 0 32rpx;
  margin-top: 40rpx;
}

.sec-h {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(166, 59, 42, 0.22);
}

.sec-ic {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(166, 59, 42, 0.45);
  border-radius: 8rpx;
  background: rgba(166, 59, 42, 0.05);
  font-family: var(--font-serif);
  font-size: var(--fs-26);
  font-weight: 700;
  color: var(--accent-vermillion);
}

.sec-t {
  flex: 1;
  min-width: 0;
  font-family: var(--font-serif);
  font-size: var(--fs-36);
  font-weight: 700;
  line-height: 1.35;
  color: #33261a;
}

/* ===== 时间线 ===== */
.timeline {
  display: flex;
  flex-direction: column;
}

.tl {
  display: flex;
  gap: 20rpx;
  padding-bottom: 28rpx;
}

/* 左栏 148rpx：容得下「1931年 / 9月18日」两行不折第三个字 */
.tl-l {
  flex: none;
  width: 148rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tl-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--bg-card);
  border: 1rpx solid rgba(181, 113, 58, 0.4);
  font-family: var(--font-serif);
  font-size: var(--fs-28);
  color: var(--accent-gold-ink);
}

.tl-date {
  margin-top: 12rpx;
  font-size: var(--fs-24);
  line-height: 1.45;
  color: var(--accent-gold-ink);
  text-align: center;
}

.tl-dt {
  display: block;
}

.tl-line {
  flex: 1;
  width: 2rpx;
  background: rgba(181, 113, 58, 0.26);
  margin-top: 12rpx;
}

.tl:last-child .tl-line {
  display: none;
}

.tl-c {
  flex: 1;
  min-width: 0;
  padding: 24rpx 26rpx;
  background: var(--bg-card);
  border: 1rpx solid rgba(107, 90, 69, 0.18);
  border-radius: var(--radius);
}

.tl.highlight .tl-c {
  border-color: rgba(166, 59, 42, 0.5);
  background: rgba(166, 59, 42, 0.05);
}

.tl-image-wrap {
  position: relative;
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 18rpx;
  background: linear-gradient(135deg, #2f2419, #4a3a28 62%, #3a2c1e);
}

.tl-image {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.tl-image-fallback {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  font-family: var(--font-serif);
  font-size: var(--fs-28);
  color: rgba(255, 247, 232, 0.9);
  text-align: center;
  z-index: 0;
}

.tl-e {
  font-size: var(--fs-28);
  font-weight: 700;
  color: #33261a;
  margin-bottom: 8rpx;
}

.tl-d {
  font-size: var(--fs-24);
  line-height: 1.68;
  color: var(--text-muted);
  text-align: justify;
}

/* ===== 十二大类 ===== */
.blk {
  padding-bottom: 36rpx;
}

/* 字标 + 名称 + 条目数：三类信息同一基线，名称吃掉剩余宽度 */
.blk-h {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.blk-mk {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: rgba(166, 59, 42, 0.07);
  border: 1rpx solid rgba(166, 59, 42, 0.3);
  border-radius: 8rpx;
  font-family: var(--font-serif);
  font-size: var(--fs-28);
  font-weight: 700;
  color: var(--accent-vermillion);
}

.blk-t {
  flex: 1;
  min-width: 0;
  font-family: var(--font-serif);
  font-size: var(--fs-30);
  font-weight: 700;
  line-height: 1.4;
  color: #33261a;
}

.blk-n {
  flex: none;
  font-size: var(--fs-24);
  color: var(--text-muted);
}

/* ===== 统一卡片语言：16rpx 圆角 / 1rpx 边线 / 24rpx 26rpx 内距 ===== */
.c {
  box-sizing: border-box;
  background: var(--bg-card);
  border: 1rpx solid rgba(107, 90, 69, 0.18);
  border-radius: var(--radius);
  padding: 24rpx 26rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 两列：gap 16rpx 时每格 basis 取 (50% - 8rpx)，奇数项最后一行只占半格 */
.g2 {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.g2 > .c {
  flex: 1 1 calc(50% - 8rpx);
  min-width: 0;
}

/* 惨案卡 */
.mass-h {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.mass-n {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-28);
  font-weight: 700;
  color: #33261a;
}

.mass-v {
  flex: none;
  max-width: 58%;
  font-size: var(--fs-24);
  font-weight: 700;
  color: var(--accent-vermillion);
  text-align: right;
}

.mass-m {
  font-size: var(--fs-24);
  color: var(--accent-gold-ink);
  margin-bottom: 8rpx;
}

.mass-x {
  font-size: var(--fs-24);
  line-height: 1.62;
  color: var(--text-muted);
}

/* 部队卡 */
.unit-code {
  font-family: var(--font-serif);
  font-size: var(--fs-32);
  font-weight: 700;
  color: var(--accent-gold-ink);
  margin-bottom: 4rpx;
}

.unit-base {
  font-size: var(--fs-24);
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.unit-crime {
  font-size: var(--fs-24);
  line-height: 1.65;
  color: var(--text-muted);
}

/* 数据行：.c 与 .key 同用，padding 收紧一档 */
.key {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 18rpx 24rpx;
}

.key-l {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

.key-v {
  font-size: var(--fs-28);
  font-weight: 700;
  color: var(--accent-vermillion);
}

.key-e {
  font-size: var(--fs-24);
  color: var(--text-muted);
}

/* 战例卡（细菌战 / 轰炸） */
.cc-h {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.cc-n {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-28);
  font-weight: 700;
  color: #33261a;
}

.cc-t {
  flex: none;
  max-width: 55%;
  font-size: var(--fs-24);
  color: var(--accent-gold-ink);
  text-align: right;
}

.cc-g {
  font-size: var(--fs-24);
  color: var(--text-muted);
  margin-bottom: 6rpx;
}

.cc-c {
  font-size: var(--fs-24);
  font-weight: 700;
  color: var(--accent-vermillion);
}

/* 文本型条目 */
.txt {
  font-size: var(--fs-26);
  line-height: 1.72;
  color: var(--text-muted);
}

.text-term {
  color: var(--accent-gold-ink);
  font-weight: 600;
}

/* 统计 / 审判两列卡 */
.stat-l,
.trial-l {
  font-size: var(--fs-24);
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.stat-v {
  font-size: var(--fs-30);
  font-weight: 700;
  line-height: 1.4;
  color: var(--accent-vermillion);
}

.trial-v {
  font-size: var(--fs-28);
  font-weight: 700;
  line-height: 1.45;
  color: #33261a;
}

.trial-death {
  color: var(--accent-vermillion);
}

/* 类别注记 */
.cn {
  margin-top: 16rpx;
  padding: 18rpx 24rpx;
  font-size: var(--fs-24);
  line-height: 1.65;
  color: var(--text-muted);
  background: var(--bg-card);
  border: 1rpx solid rgba(107, 90, 69, 0.18);
  border-left: 6rpx solid rgba(181, 113, 58, 0.5);
  border-radius: var(--radius);
}

/* ===== 战犯卡 ===== */
.crim {
  display: flex;
  gap: 24rpx;
}

.crim-av {
  position: relative;
  flex: none;
  width: 110rpx;
  height: 130rpx;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2f2419, #4a3a28);
  border: 1rpx solid rgba(181, 113, 58, 0.3);
}

.crim-av-img {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.crim-av-t {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-serif);
  font-size: 48rpx;
  font-weight: 700;
  color: rgba(255, 247, 232, 0.85);
  z-index: 0;
}

.crim-no {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  padding: 2rpx 10rpx;
  font-size: var(--fs-20);
  font-weight: 700;
  color: #ffffff;
  background: rgba(166, 59, 42, 0.9);
}

.crim-info {
  flex: 1;
  min-width: 0;
}

.crim-n {
  font-size: var(--fs-32);
  font-weight: 700;
  color: #33261a;
  margin-bottom: 4rpx;
}

.crim-p {
  font-size: var(--fs-24);
  line-height: 1.5;
  color: var(--accent-gold-ink);
  margin-bottom: 8rpx;
}

.crim-c {
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.crim-s {
  font-size: var(--fs-24);
  font-weight: 700;
  color: var(--accent-vermillion);
}

/* ===== 资料来源 + 结语 ===== */
.src {
  position: relative;
  padding: 18rpx 24rpx 18rpx 52rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--text-muted);
}

.src::before {
  content: '';
  position: absolute;
  left: 24rpx;
  top: 30rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--accent-gold);
}

.final {
  margin-top: 28rpx;
  padding: 28rpx 24rpx;
  text-align: center;
  background: rgba(181, 113, 58, 0.06);
  border: 1rpx solid rgba(181, 113, 58, 0.24);
  border-radius: var(--radius);
}

.final-p {
  font-family: var(--font-serif);
  font-size: var(--fs-28);
  line-height: 1.9;
  font-weight: 600;
  color: var(--accent-gold-ink);
}

.final-p + .final-p {
  margin-top: 8rpx;
}

/* 固定断行：14px 下整句会甩出「来。」孤字，按语义停顿手工断 */
.final-l {
  display: block;
}

.bottom-spacer {
  height: calc(80rpx + env(safe-area-inset-bottom));
}
