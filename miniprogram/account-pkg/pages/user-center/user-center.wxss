/* ==========================================================================
   个人中心（消息 / 收藏 / 历史 / 设备）—— 暖调，与「我的」页一致
   ========================================================================== */
page {
  background: var(--bg-primary);
}

.body {
  height: 100vh;
  overflow: scroll;
  -webkit-overflow-scrolling: touch;
}

/* ---------- 用户卡 ---------- */
.uc-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 8rpx 40rpx 36rpx;
}
.uc-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--tile-deep);
  display: flex;
  align-items: center;
  justify-content: center;
}
.uc-avatar-text {
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 700;
  color: var(--tile-deep-text);
}
.uc-meta {
  flex: 1;
  min-width: 0;
}
.uc-name {
  display: block;
  font-family: var(--font-serif);
  font-size: var(--fs-38);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0;
}
.uc-sub {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-24);
  color: var(--text-muted);
}
/* 头部资料加载失败的重试入口（朱砂红，与全站警示色一致） */
.uc-retry {
  color: var(--accent-vermillion);
}

/* ---------- 分类切换 ---------- */
.uc-tabs {
  display: flex;
  margin: 0 40rpx 8rpx;
  border-bottom: 2rpx solid var(--border-subtle);
}
.uc-tab {
  position: relative;
  flex: 1;
  padding: 22rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.uc-tab-text {
  font-size: 30rpx;
  color: var(--text-muted);
}
.uc-tab-active .uc-tab-text {
  color: var(--accent-gold-ink);
  font-weight: 700;
}
.uc-tab-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -2rpx;
  width: 56rpx;
  height: 6rpx;
  margin-left: -28rpx;
  border-radius: 4rpx;
  background: var(--accent-gold);
}
.uc-tab-badge {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 15rpx;
  background: var(--accent-vermillion);
  color: #fff;
  font-size: var(--fs-20);
  line-height: 30rpx;
  text-align: center;
}

/* ---------- 工具条 ---------- */
.uc-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 40rpx 12rpx;
}
.uc-bar-text {
  font-size: var(--fs-24);
  color: var(--text-muted);
}
.uc-bar-action {
  font-size: var(--fs-26);
  color: var(--accent-gold-ink);
}

/* ---------- 列表 ---------- */
.uc-list,
.uc-group {
  padding: 0 40rpx;
}
.uc-group {
  margin-top: 28rpx;
}
.uc-group-title {
  font-size: 26rpx;
  color: var(--text-muted);
  letter-spacing: 0;
  margin-bottom: 16rpx;
}

.uc-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border-subtle);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.uc-item-main {
  flex: 1;
  min-width: 0;
}
.uc-item-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}
.uc-item-tag {
  font-size: var(--fs-22);
  color: var(--accent-gold-ink);
  background: var(--accent-glow);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}
.uc-item-time {
  font-size: 22rpx;
  color: var(--text-muted);
}
.uc-item-title {
  display: block;
  font-family: var(--font-serif);
  font-size: var(--fs-30);
  font-weight: 500;
  line-height: 1.5;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.uc-item-summary {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-24);
  line-height: 1.5;
  color: var(--text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.uc-item-remove {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  border: 2rpx solid var(--border-color);
  border-radius: 8rpx;
}

/* ---------- 消息 ---------- */
.uc-msg-item {
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border-subtle);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}
.uc-msg-unread {
  border-left: 6rpx solid var(--accent-gold);
}
.uc-msg-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.uc-msg-type {
  font-size: var(--fs-22);
  color: var(--accent-gold-ink);
  background: var(--accent-glow);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}
.uc-msg-time {
  font-size: 22rpx;
  color: var(--text-muted);
}
.uc-msg-title {
  display: block;
  font-size: var(--fs-30);
  font-weight: 600;
  color: var(--text-primary);
}
.uc-msg-unread .uc-msg-title::after {
  content: ' · 未读';
  font-size: 22rpx;
  font-weight: 400;
  color: var(--accent-vermillion);
}
.uc-msg-body {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-26);
  line-height: 1.7;
  color: var(--text-secondary);
}

/* ---------- 空态 / 加载 ---------- */
.uc-empty {
  padding: 140rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.uc-empty-text {
  font-size: var(--fs-28);
  color: var(--text-muted);
}
.uc-empty-hint {
  margin-top: 14rpx;
  font-size: var(--fs-24);
  color: var(--text-muted);
}
.uc-loading {
  padding: 140rpx 40rpx;
  text-align: center;
  font-size: var(--fs-28);
  color: var(--text-muted);
}

.uc-bottom-space {
  height: calc(80rpx + env(safe-area-inset-bottom));
}
