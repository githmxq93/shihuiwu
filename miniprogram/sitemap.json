{
  "desc": "微信搜一搜页面收录白名单。公开内容页一律 allow；账号/隐私/后台页显式 disallow。新增页面默认不索引，加页面时须同步在此登记。",
  "rules": [
    { "action": "allow", "page": "pages/index/index" },
    { "action": "allow", "page": "pages/article/article", "params": ["id"], "matching": "inclusive" },
    { "action": "allow", "page": "pages/topic-list/topic-list" },
    { "action": "allow", "page": "pages/query/query" },
    { "action": "allow", "page": "topic-pkg/pages/campaign/campaign" },
    { "action": "allow", "page": "topic-pkg/pages/treaty/treaty" },
    { "action": "allow", "page": "topic-pkg/pages/liberation/liberation" },
    { "action": "allow", "page": "topic-pkg/pages/remember/remember" },
    { "action": "allow", "page": "pages/festivals/festivals" },
    { "action": "allow", "page": "pages/dynasty-timeline/dynasty-timeline" },
    { "action": "allow", "page": "pages/emperors/emperors" },
    { "action": "allow", "page": "pages/official-alias/official-alias" },
    { "action": "allow", "page": "pages/stats/stats" },
    { "action": "allow", "page": "pages/six-degrees/six-degrees" },
    { "action": "allow", "page": "account-pkg/pages/policy/policy", "params": ["type"], "matching": "inclusive" },
    { "action": "allow", "page": "detail-pkg/pages/detail/detail", "params": ["id"], "matching": "inclusive" },
    { "action": "allow", "page": "topic-pkg/pages/topic/topic", "params": ["topic"], "matching": "inclusive" },
    { "action": "allow", "page": "footprint-pkg/pages/footprint/footprint" },

    { "action": "allow", "page": "timeline-pkg/pages/timeline/timeline" },
    { "action": "allow", "page": "timeline-pkg/pages/timeline/timeline", "params": ["year"], "matching": "inclusive" },
    { "action": "allow", "page": "parallel-pkg/pages/compare/compare" },
    { "action": "allow", "page": "parallel-pkg/pages/parallel/parallel" },
    { "action": "allow", "page": "lineage-pkg/pages/lineage/lineage" },
    { "action": "allow", "page": "lineage-pkg/pages/lineage/lineage", "params": ["id"], "matching": "inclusive" },
    { "action": "allow", "page": "chart-pkg/pages/graph/graph" },
    { "action": "allow", "page": "chart-pkg/pages/graph/graph", "params": ["id"], "matching": "inclusive" },

    { "action": "allow", "page": "detail-pkg/pages/dual/dual", "params": ["a", "b"], "matching": "inclusive" },
    { "action": "allow", "page": "timeline-pkg/pages/calendar/calendar" },
    { "action": "allow", "page": "parallel-pkg/pages/who-present/who-present", "params": ["year"], "matching": "inclusive" },
    { "action": "allow", "page": "account-pkg/pages/about/about" },

    { "action": "disallow", "page": "pages/profile/profile" },
    { "action": "disallow", "page": "account-pkg/pages/user-center/user-center" },
    { "action": "disallow", "page": "account-pkg/pages/cancel-account/cancel-account" },
    { "action": "disallow", "page": "account-pkg/pages/feedback/feedback" },
    { "action": "disallow", "page": "admin-pkg/pages/login/login" },
    { "action": "disallow", "page": "admin-pkg/pages/dashboard/dashboard" },
    { "action": "disallow", "page": "admin-pkg/pages/articles/articles" },
    { "action": "disallow", "page": "admin-pkg/pages/users/users" },
    { "action": "disallow", "page": "admin-pkg/pages/figures/figures" },
    { "action": "disallow", "page": "admin-pkg/pages/topics/topics" },
    { "action": "disallow", "page": "admin-pkg/pages/messages/messages" },
    { "action": "disallow", "page": "*" }
  ]
