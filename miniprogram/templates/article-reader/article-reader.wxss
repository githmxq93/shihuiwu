/* ==========================================================================
   文章阅读主体样式（唯一来源）
   使用方：components/articleOverlay、pages/article
   口径（与 _design/topic/detail/overlay-b.html 一致）：
     元信息 22rpx · 标题 40rpx/1.45/900 · 正文 30rpx/1.85 · 段距 24rpx · 行内 letter-spacing 0
   文字色一律走全局 token：--text-primary / --text-secondary / --text-muted /
     --accent-gold-ink（2026-11-14 全站更新后的值），不写回旧灰值。
   ========================================================================== */

/* ---------- 元信息：朝代签 + 字数 + 阅读时长 ---------- */
.ar-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: var(--fs-22);
  line-height: 1.4;
  color: var(--text-muted, var(--text-muted));
  letter-spacing: 0;
}

.ar-era {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(181, 113, 58, 0.3);
  background: rgba(255, 250, 240, 0.66);
  font-size: var(--fs-22);
  line-height: 1.4;
  font-weight: 600;
  color: var(--accent-gold-ink, var(--accent-gold-ink));
  letter-spacing: 0;
}

.ar-dot {
  color: rgba(61, 46, 31, 0.28);
}

/* ---------- 标题与分隔线 ---------- */
.ar-title {
  font-family: var(--font-serif, 'Noto Serif SC', 'Source Han Serif SC', serif);
  font-size: var(--fs-40);
  line-height: 1.45;
  font-weight: 900;
  color: var(--text-primary, var(--text-primary));
  letter-spacing: 0;
  margin-top: 20rpx;
}

.ar-rule {
  height: 1rpx;
  background: rgba(181, 113, 58, 0.18);
  margin: 28rpx 0;
}

/* ---------- 摘要说明（只有摘要、没有正文时） ---------- */
.ar-note {
  margin: 8rpx 0 28rpx;
  padding: 24rpx 24rpx;
  background: rgba(181, 113, 58, 0.08);
  border-left: 4rpx solid rgba(181, 113, 58, 0.45);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ar-note-title {
  font-size: var(--fs-26);
  line-height: 1.5;
  font-weight: 700;
  color: var(--accent-gold-ink, var(--accent-gold-ink));
  letter-spacing: 0;
}

.ar-note-text {
  font-size: var(--fs-24);
  line-height: 1.7;
  color: var(--text-muted, var(--text-muted));
  letter-spacing: 0;
}

/* ---------- 正文：真段落 ---------- */
.ar-body {
  font-size: var(--fs-30);
  line-height: 1.85;
  color: var(--text-primary, var(--text-primary));
  letter-spacing: 0;
  word-break: break-word;
}

.ar-body-plain {
  text-indent: 0;
  margin-top: 8rpx;
}

.ar-p {
  margin: 0 0 24rpx;
  text-indent: 2em;
}

.ar-p:last-child {
  margin-bottom: 0;
}

.ar-h2 {
  font-family: var(--font-serif, 'Noto Serif SC', 'Source Han Serif SC', serif);
  font-size: var(--fs-32);
  line-height: 1.5;
  font-weight: 700;
  color: var(--text-primary, var(--text-primary));
  margin: 40rpx 0 20rpx;
  text-indent: 0;
  letter-spacing: 0;
}

.ar-quote {
  margin: 0 0 24rpx;
  padding-left: 24rpx;
  border-left: 4rpx solid rgba(181, 113, 58, 0.35);
  color: var(--text-muted, var(--text-muted));
  text-indent: 0;
}

.ar-hr {
  height: 1rpx;
  background: rgba(181, 113, 58, 0.18);
  margin: 32rpx 0;
}

.ar-b {
  font-weight: 700;
}

.ar-i {
  font-style: italic;
}

/* 正文里可点的人名：金色文字 + 细虚线下划线（不是正文主体色） */
.ar-fig-link {
  color: var(--accent-gold-ink, var(--accent-gold-ink));
  border-bottom: 2rpx dotted rgba(181, 113, 58, 0.45);
  padding-bottom: 1rpx;
}

/* 表格 */
.ar-table {
  margin: 0 0 24rpx;
  border: 1rpx solid rgba(181, 113, 58, 0.18);
  border-radius: 8rpx;
  overflow: hidden;
}

.ar-tr {
  display: flex;
  border-top: 1rpx solid rgba(181, 113, 58, 0.12);
}

.ar-tr:first-child {
  border-top: 0;
}

.ar-tr-head {
  background: rgba(181, 113, 58, 0.08);
  font-weight: 600;
}

.ar-td {
  flex: 1;
  min-width: 0;
  padding: 12rpx 16rpx;
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--text-primary, var(--text-primary));
  text-indent: 0;
  word-break: break-word;
}

/* ---------- · 完 · ---------- */
.ar-end {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 56rpx 0 48rpx;
}

.ar-end-line {
  flex: 1;
  height: 1rpx;
  background: rgba(181, 113, 58, 0.18);
}

.ar-end-text {
  font-size: var(--fs-24);
  line-height: 1.4;
  color: var(--text-muted, var(--text-muted));
  letter-spacing: 0;
}

/* ---------- 文末三块 ---------- */
.ar-section {
  margin-top: 48rpx;
}

.ar-sec-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 文中人物 / 参考文献标题前的深棕竖条；关键词标题不加 */
.ar-sec-head.has-bar::before {
  content: '';
  flex: none;
  width: 6rpx;
  height: 32rpx;
  background: var(--accent-gold-ink, var(--accent-gold-ink));
}

.ar-sec-title {
  font-family: var(--font-serif, 'Noto Serif SC', 'Source Han Serif SC', serif);
  font-size: var(--fs-28);
  line-height: 1.5;
  font-weight: 700;
  color: var(--text-primary, var(--text-primary));
  letter-spacing: 0;
}

.ar-sec-sub {
  margin-left: auto;
  font-size: var(--fs-22);
  line-height: 1.4;
  color: var(--text-muted, var(--text-muted));
  letter-spacing: 0;
}

/* 文中人物：整行米底 + 左侧暖棕竖条 */
.ar-fig {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #f2ede4;
  border-left: 4rpx solid var(--accent-gold, var(--accent-gold));
}

.ar-fig.is-dim {
  opacity: 0.62;
}

.ar-fig-hover {
  background: #ece4d8;
}

.ar-fig-avatar {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(181, 113, 58, 0.12);
  box-shadow: inset 0 0 0 2rpx rgba(250, 247, 242, 0.7);
}

.ar-fig-avatar-text {
  font-family: var(--font-serif, 'Noto Serif SC', 'Source Han Serif SC', serif);
  font-size: var(--fs-22);
  line-height: 1;
  font-weight: 700;
  color: var(--accent-gold-ink, var(--accent-gold-ink));
}

.ar-fig-body {
  flex: 1;
  min-width: 0;
}

.ar-fig-name {
  font-size: var(--fs-32);
  line-height: 1.4;
  font-weight: 700;
  color: var(--text-primary, var(--text-primary));
  letter-spacing: 0;
}

.ar-fig-meta {
  margin-top: 8rpx;
  font-size: var(--fs-24);
  line-height: 1.5;
  color: var(--text-muted, var(--text-muted));
  letter-spacing: 0;
}

.ar-fig-arrow {
  flex: none;
  font-size: var(--fs-32);
  color: var(--text-muted, var(--text-muted));
}

/* 参考文献：金色描边序号 + 两行文字 + 行间细分隔线 */
.ar-cit {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(181, 113, 58, 0.14);
}

.ar-cit:last-child {
  border-bottom: 0;
}

.ar-cit-index {
  flex: none;
  box-sizing: border-box;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;           /* 40rpx 减去上下各 2rpx 描边 */
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid rgba(181, 113, 58, 0.55);
  background: rgba(255, 250, 240, 0.5);
  font-size: var(--fs-24);
  font-weight: 700;
  color: var(--accent-gold-ink, var(--accent-gold-ink));
}

.ar-cit-body {
  flex: 1;
  min-width: 0;
}

.ar-cit-name {
  font-size: var(--fs-28);
  line-height: 1.55;
  font-weight: 700;
  color: var(--text-primary, var(--text-primary));
  word-break: break-word;
  letter-spacing: 0;
}

.ar-cit-name-link {
  color: var(--accent-gold-ink, var(--accent-gold-ink));
}

.ar-cit-meta {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-24);
  line-height: 1.5;
  color: var(--text-muted, var(--text-muted));
  letter-spacing: 0;
}

/* 关键词 */
.ar-kw-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.ar-kw {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(181, 113, 58, 0.08);
  border: 1rpx solid rgba(181, 113, 58, 0.14);
  font-size: var(--fs-22);
  line-height: 1.5;
  color: var(--text-muted, var(--text-muted));
  letter-spacing: 0;
}

/* ---------- 底部翻篇条（浮层内 / 整页 fixed 共用） ---------- */
.ar-foot {
  position: relative;
  flex: none;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 0 0 env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  background: var(--bg-card);
  border-top: 1rpx solid rgba(181, 113, 58, 0.14);
  font-size: var(--fs-24);
  color: var(--text-muted, var(--text-muted));
}

/* 左右两段各占一半可用宽度，点击热区 = 整段 */
.ar-foot-side {
  flex: 1;
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0 16rpx;
  box-sizing: border-box;
  font-size: var(--fs-24);
  color: var(--text-primary, var(--text-primary));
  letter-spacing: 0;
}

.ar-foot-prev {
  justify-content: flex-start;
  padding-left: 32rpx;
}

.ar-foot-next {
  justify-content: flex-end;
  padding-right: 32rpx;
}

.ar-foot-side:active {
  background: rgba(61, 46, 31, 0.05);
}

.ar-foot-side.is-dim {
  color: var(--text-muted, var(--text-muted));
}

.ar-foot-home {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: var(--fs-24);
  font-weight: 700;
  color: var(--accent-gold-ink, var(--accent-gold-ink));
  letter-spacing: 0;
}

.ar-foot-home:active {
  background: rgba(181, 113, 58, 0.1);
}

/* 浮层内的阅读进度线，贴在底部条上沿 */
.ar-progress {
  position: absolute;
  top: -1rpx;
  left: 0;
  right: 0;
  height: 4rpx;
  background: transparent;
}

.ar-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--accent-gold, var(--accent-gold)), var(--accent-gold-light, var(--accent-gold-light)));
  border-radius: 2rpx;
  transition: width 0.1s;
}
