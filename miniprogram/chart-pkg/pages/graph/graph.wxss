/* 独立「关系图谱」页 —— 博物馆暖调 */
.page {
  min-height: 100vh;
  background: var(--bg-primary);
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

.nav-spacer {
  width: 100%;
}

/* ===== 页面级搜索 ===== */
.search-area {
  position: relative;
  padding: 8rpx 32rpx 0;
  z-index: 30;
}

.search-box {
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 28rpx;
  background: var(--bg-card);
  border: 2rpx solid #dccdb2;
  border-radius: 42rpx;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.search-box.focused {
  border-color: var(--accent-gold-ink);
  box-shadow: 0 4rpx 20rpx rgba(181, 113, 58, 0.15);
}

.search-icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.search-icon-circle {
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid var(--text-muted);
  border-radius: 50%;
  box-sizing: border-box;
}

.search-icon-handle {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 12rpx;
  height: 3rpx;
  background: var(--text-muted);
  border-radius: 2rpx;
  transform: rotate(45deg);
  transform-origin: right center;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: var(--fs-28);
  color: var(--text-primary);
}

.search-placeholder {
  color: #8a6a46;               /* 4.65:1（原 #a99880 仅 2.48:1） */
  font-size: var(--fs-26);
}

.search-clear {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: var(--fs-26);
  color: var(--text-muted);
  background: #efe4d0;
  border-radius: 50%;
  flex-shrink: 0;
}

/* 清空：视觉 40rpx 圆点，热区 88×88rpx（44px）；只向右扩 48rpx，
   吸收搜索框内边距 28rpx + 页面留白 20rpx，不覆盖左侧输入框。 */
.search-clear::after {
  content: '';
  position: absolute;
  left: 0;
  right: -48rpx;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

.search-dropdown {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 100rpx;
  background: var(--bg-card);
  border: 2rpx solid #dccdb2;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 36rpx rgba(61, 46, 31, 0.14);
  overflow: hidden;
}

.dropdown-item {
  padding: 22rpx 30rpx;
  border-bottom: 2rpx solid #efe4d0;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item:active {
  background: var(--bg-primary);
}

.dropdown-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.dropdown-meta {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ===== 中心人物条 ===== */
.center-chip {
  display: flex;
  align-items: baseline;
  margin: 20rpx 32rpx 0;
  padding: 18rpx 28rpx;
  background: var(--tile-deep);
  border-radius: 18rpx;
}

.center-label {
  font-size: var(--fs-22);
  color: rgba(244, 237, 225, 0.6);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.center-name {
  font-size: var(--fs-32);
  font-weight: 700;
  color: var(--tile-deep-text);
  letter-spacing: 0;
}

.center-count {
  margin-left: auto;
  font-size: var(--fs-22);
  color: #d9a86c;
  flex-shrink: 0;
}

/* ===== 图谱区 ===== */
.graph-area {
  position: relative;
  margin: 20rpx 32rpx 0;
  z-index: 1;
}

/* 状态视图（加载/失败/空） */
.state-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 700rpx;
  background: var(--bg-card);
  border: 2rpx solid #dccdb2;
  border-radius: 20rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.state-icon {
  font-size: 64rpx;
  color: var(--accent-gold-ink);
  margin-bottom: 24rpx;
}

.state-text {
  font-size: 28rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.7;
}

.state-text-sub {
  font-size: var(--fs-24);
  color: #b0a289;
  margin-top: 4rpx;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid #e5d9c4;
  border-top-color: var(--accent-gold-ink);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.retry-btn {
  margin-top: 28rpx;
  padding: 16rpx 52rpx;
  background: var(--accent-gold);
  color: var(--text-inverse);
  font-size: 28rpx;
  border-radius: 40rpx;
}

.retry-btn:active {
  opacity: 0.85;
}
