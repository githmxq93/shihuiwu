.graph-wrapper {
  width: 100%;
  background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-secondary) 30%, var(--bg-primary) 60%, var(--bg-deep) 100%);
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
}

.graph-wrapper::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 20% 30%, rgba(181, 113, 58,0.08) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(181, 113, 58,0.06) 0%, transparent 50%);
  pointer-events: none;
}

.graph-header {
  padding: 24rpx 28rpx 0;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.graph-title {
  font-size: var(--fs-30);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0;
}

.graph-subtitle {
  font-size: var(--fs-22);
  color: #b8b0a0;
  font-weight: 400;
}

.graph-canvas {
  width: 100%;
  height: 960rpx;
  position: relative;
  overflow: hidden;
  z-index: 1;
}

.legend-bar {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 4rpx 12rpx;
  padding: 10rpx 16rpx 4rpx;
  background: var(--bg-card);
  position: relative;
  z-index: 1;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 3rpx;
}

.legend-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-label {
  font-size: 18rpx;
  color: var(--text-muted);
  white-space: nowrap;
}

.graph-hint {
  font-size: var(--fs-20);
  color: #8a8375;
  text-align: center;
  padding: 8rpx 24rpx 16rpx;
  background: var(--bg-card);
  position: relative;
  z-index: 1;
}

.filter-dropdown {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  z-index: 10;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  /* backdrop-filter 已移除（2026-10-15 真机白屏专项收尾）：底色 #fbf7ef 已是不透明色，
     模糊无实际效果；本组件是图片/图谱密集页，避免额外的离屏取样开销。 */
  background: var(--bg-card);
  border: 1rpx solid rgba(181, 113, 58, 0.15);
  border-radius: var(--radius-lg);
  padding: 8rpx 18rpx 8rpx 22rpx;
}

.filter-label {
  font-size: var(--fs-24);
  color: var(--text-secondary);
  font-weight: 500;
  letter-spacing: 0;
}

.filter-arrow {
  font-size: var(--fs-20);
  color: var(--text-muted);
}

