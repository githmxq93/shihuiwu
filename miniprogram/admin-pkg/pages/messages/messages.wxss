/* ============================================================
   后台「消息管理」（与 Web 端 AdminMessages 对齐）
   5 个模块：站内公告 / 站内信 / 消息模板 / 触发推送 / 反馈管理
   配色沿用后台既有变量（app.wxss 的 page 上定义）：米色底 + 木质棕 + 朱砂红
   ============================================================ */

page {
  background: var(--bg-primary);
  min-height: 100vh;
}

.page-wrapper { display:flex; flex-direction:column; height:100vh; box-sizing:border-box; }

/* ===== 导航 ===== */
/* 导航栏：padding-top 的 88rpx 只是**首帧兜底**，实际值由 WXML 注入
   `style="padding-top: {{safeAreaTop}}px"`（真实状态栏高度）覆盖 ——
   不能只靠 88rpx(=44px)，刘海/灵动岛机型状态栏更高会把标题压住 */
.nav-bar { flex-shrink:0; background:var(--bg-elevated); border-bottom:1rpx solid var(--border-subtle); padding-top:88rpx; position:sticky; top:0; z-index:100; }
.nav-inner { display:flex; align-items:center; height:44px; padding:0 16px; }
.nav-back { display:flex; align-items:center; gap:4rpx; padding:8rpx 16rpx; flex-shrink:0; }
.back-arrow { font-size: var(--fs-40); color: var(--accent-gold-ink); line-height:1; }
.back-text { font-size: var(--fs-28); color: var(--accent-gold-ink); }
.nav-title { flex:1; text-align:center; font-size: var(--fs-32); font-weight:700; color:var(--text-primary); letter-spacing: 0; }
.nav-right { width:120rpx; flex-shrink:0; }

/* ===== 模块 Tab（横向滚动） ===== */
.tab-scroll { flex-shrink:0; background:var(--bg-elevated); border-bottom:1rpx solid var(--border-subtle); white-space:nowrap; }
.tab-row { display:inline-flex; align-items:center; padding:12rpx 16rpx; }
.tab-item { flex-shrink:0; padding:14rpx 28rpx; margin-right:12rpx; border-radius:32rpx; background:var(--bg-deep); transition:all 0.2s ease; }
.tab-item:last-child { margin-right:0; }
.tab-item.is-active { background:var(--accent-gold); }
.tab-text { font-size: var(--fs-26); color:var(--text-secondary); letter-spacing: 0; }
.tab-item.is-active .tab-text { color:#fff; font-weight:700; }

/* ===== 内容区 ===== */
.content-scroll { flex:1; overflow:scroll; -webkit-overflow-scrolling:touch; }
.tab-pane { padding:16rpx 20rpx 0; }

.pane-tool { display:flex; align-items:center; justify-content:space-between; padding:8rpx 4rpx 16rpx; }
.pane-count { font-size: var(--fs-24); color:var(--text-muted); letter-spacing: 0; }
.pane-add { font-size: var(--fs-26); font-weight:600; color:#fff; background:var(--accent-gold); padding:12rpx 28rpx; border-radius: var(--radius-lg); }
.pane-add:active { opacity:0.85; }

/* ===== 列表卡片 ===== */
.list { display:flex; flex-direction:column; gap:12rpx; }
.item-card { padding:24rpx; background:var(--bg-card); border:1rpx solid var(--border-subtle); border-radius: var(--radius); box-shadow:var(--shadow-card); }
.item-head { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }
.item-title { flex:1; font-size: var(--fs-28); font-weight:700; color:var(--text-primary); letter-spacing: 0; }
.item-meta { display:flex; align-items:center; flex-wrap:wrap; gap:8rpx; margin-top:8rpx; }
.meta-chip { font-size: var(--fs-20); color: var(--accent-gold-ink); background:rgba(181, 113, 58,0.08); padding:2rpx 14rpx; border-radius:12rpx; }
.meta-time { font-size: var(--fs-20); color:var(--text-muted); }
.item-body { display:block; margin-top:10rpx; font-size: var(--fs-24); color:var(--text-secondary); line-height:1.6; word-break:break-all; }
.item-actions { display:flex; align-items:center; justify-content:flex-end; gap:12rpx; margin-top:16rpx; }
.act { font-size: var(--fs-24); padding:10rpx 24rpx; border-radius:12rpx; color:var(--text-secondary); background:var(--bg-deep); line-height:1; }
.act:active { opacity:0.75; }
.act-edit { color: var(--accent-gold-ink); background:rgba(181, 113, 58,0.08); }
.act-ok { color:#4ade80; background:rgba(74,222,128,0.10); }
.act-del { color:#f87171; background:rgba(248,113,113,0.08); }

/* ===== 徽章 ===== */
.badge { flex-shrink:0; font-size: var(--fs-20); padding:4rpx 16rpx; border-radius:20rpx; line-height:1.4; }
.badge-ok { color:#4ade80; background:rgba(74,222,128,0.12); }
.badge-draft { color:var(--text-muted); background:var(--bg-deep); }
.badge-info { color:#60a5fa; background:rgba(96,165,250,0.12); }
.badge-warn { color:#f0c87e; background:rgba(232,185,106,0.14); }

/* ===== 表单 ===== */
.form-card { padding:28rpx 24rpx; background:var(--bg-card); border:1rpx solid var(--border-subtle); border-radius: var(--radius); box-shadow:var(--shadow-card); margin-bottom:24rpx; }
.form-card-title { display:block; font-size: var(--fs-30); font-weight:700; color:var(--text-primary); letter-spacing: 0; margin-bottom:20rpx; }
.form-group { margin-bottom:24rpx; }
.form-label { display:block; font-size: var(--fs-26); font-weight:600; color:var(--text-primary); margin-bottom:10rpx; }
.form-label.required::after { content:' *'; color:#f87171; }
.form-input { width:100%; height:72rpx; padding:0 20rpx; background:var(--bg-deep); border:1rpx solid var(--border-subtle); border-radius:12rpx; font-size: var(--fs-26); color:var(--text-primary); box-sizing:border-box; }
.form-picker { display:flex; align-items:center; line-height:72rpx; }
.form-textarea { width:100%; height:140rpx; padding:16rpx 20rpx; background:var(--bg-deep); border:1rpx solid var(--border-subtle); border-radius:12rpx; font-size: var(--fs-26); color:var(--text-primary); box-sizing:border-box; line-height:1.5; }
.form-textarea-lg { height:260rpx; }
.form-btn { height:80rpx; line-height:80rpx; text-align:center; border-radius: var(--radius); font-size: var(--fs-30); font-weight:600; letter-spacing: 0; color:#fff; background:var(--accent-gold); }
.form-btn:active { opacity:0.9; }
.form-btn.is-disabled { opacity:0.6; }
.form-btn-cancel { color:var(--text-secondary); background:var(--bg-deep); }
.form-btn-warn { background:var(--accent-vermillion); }

.fold-toggle { margin-top:20rpx; padding:16rpx 0; font-size: var(--fs-26); color: var(--accent-gold-ink); text-align:center; }
.warn-box { margin-bottom:20rpx; padding:18rpx 20rpx; border-radius:12rpx; font-size: var(--fs-22); line-height:1.6; color:var(--accent-vermillion); background:rgba(166,59,42,0.07); border:1rpx solid rgba(166,59,42,0.18); }
.hint-box { margin-bottom:20rpx; padding:18rpx 20rpx; border-radius:12rpx; font-size: var(--fs-22); line-height:1.6; color:var(--text-secondary); background:var(--bg-deep); }
.result-text { margin-top:18rpx; font-size: var(--fs-24); color: var(--accent-gold-ink); text-align:center; }

/* ===== 反馈管理 ===== */
.fb-toolbar { display:flex; flex-direction:column; gap:16rpx; padding:8rpx 0 16rpx; }
.fb-chips { display:flex; align-items:center; flex-wrap:wrap; gap:12rpx; }
.fb-chip { font-size: var(--fs-24); color:var(--text-secondary); padding:10rpx 26rpx; border-radius: var(--radius-lg); background:var(--bg-deep); }
.fb-chip.is-active { color:#fff; font-weight:700; background:var(--accent-gold); }
.fb-search { height:68rpx; padding:0 24rpx; background:var(--bg-deep); border:1rpx solid var(--border-subtle); border-radius:34rpx; font-size: var(--fs-26); color:var(--text-primary); }
.fb-img { width:160rpx; height:160rpx; margin-top:14rpx; border-radius:12rpx; border:1rpx solid var(--border-subtle); }
.fb-reply-box { display:flex; gap:12rpx; margin-top:14rpx; padding:16rpx 20rpx; border-radius:12rpx; background:rgba(181,113,58,0.08); border:1rpx solid rgba(181,113,58,0.2); }
.fb-reply-label { flex-shrink:0; font-size: var(--fs-22); font-weight:700; color: var(--accent-gold-ink); }
.fb-reply-text { flex:1; font-size: var(--fs-22); color:var(--text-secondary); line-height:1.6; word-break:break-all; }
.fb-reply-input { margin-top:14rpx; }

/* ===== 状态 ===== */
.empty-state { display:flex; justify-content:center; padding:80rpx 0; }
.empty-text { font-size: var(--fs-28); color:var(--text-muted); }
.loading-more { display:flex; justify-content:center; padding:24rpx 0; font-size: var(--fs-24); color:var(--text-muted); }
.bottom-spacer { height:calc(120rpx + env(safe-area-inset-bottom)); }

/* ===== 弹层（与 articles 页同款） ===== */
.modal-overlay { position:fixed; top:0; left:0; right:0; bottom:0; z-index:200; background:rgba(181,113,58,0.4); display:flex; align-items:flex-end; justify-content:center; }
.modal-content { width:100%; max-height:85vh; background:var(--bg-primary); border-radius:24rpx 24rpx 0 0; display:flex; flex-direction:column; }
.modal-header { flex-shrink:0; display:flex; align-items:center; justify-content:space-between; padding:28rpx 32rpx; border-bottom:1rpx solid var(--border-subtle); }
.modal-title { font-size: var(--fs-34); font-weight:700; color:var(--text-primary); letter-spacing: 0; }
.modal-close { font-size: var(--fs-32); color:var(--text-muted); padding:8rpx; width:48rpx; height:48rpx; text-align:center; line-height:48rpx; border-radius:50%; background:rgba(181,113,58,0.06); }
.modal-close:active { background:rgba(181,113,58,0.12); }
.modal-body { flex:1; overflow:scroll; -webkit-overflow-scrolling:touch; padding:24rpx 32rpx; }
.modal-footer { flex-shrink:0; display:flex; gap:20rpx; padding:24rpx 32rpx; padding-bottom:calc(24rpx + env(safe-area-inset-bottom)); border-top:1rpx solid var(--border-subtle); }
.modal-footer .form-btn { flex:1; }
