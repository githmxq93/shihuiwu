<import src="../../../templates/admin-nav/admin-nav.wxml" />
<view class="page-wrapper">
  <!-- 导航：padding-top 注入真实状态栏高度（写死会被刘海/灵动岛机型压住） -->
  <template is="admin-nav" data="{{title: '用户管理', safeAreaTop: safeAreaTop, emptyRightClass: 'nav-placeholder'}}" />

  <!-- 三个管理 Tab（与 Web 端一致：基础管理 / 状态控制 / 权限管理） -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === item.key ? 'is-active' : ''}}"
          wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="onSwitchTab">{{item.label}}</view>
  </view>

  <!-- 工具栏：搜索（+ 基础管理的新增、权限管理的角色筛选） -->
  <view class="tool-bar">
    <view class="search-wrap">
      <text class="search-icon">查</text>
      <input class="search-input" placeholder="搜索昵称 / 显示名 / 手机号" value="{{keyword}}" bindinput="onKeywordInput" />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword">✕</text>
    </view>
    <view class="add-btn" wx:if="{{activeTab === 'basic'}}" bindtap="onCreateOpen">＋ 新增</view>
    <picker wx:if="{{activeTab === 'permission'}}" mode="selector" range="{{roleFilterLabels}}" value="{{roleFilterIndex}}" bindchange="onRoleFilterChange">
      <view class="role-filter">{{roleFilterLabels[roleFilterIndex]}} ▾</view>
    </picker>
  </view>

  <!-- 状态筛选（仅状态控制 Tab） -->
  <view class="chip-bar" wx:if="{{activeTab === 'status'}}">
    <view class="chip {{statusFilter === item.key ? 'is-active' : ''}}"
          wx:for="{{statusFilters}}" wx:key="key" data-key="{{item.key}}" bindtap="onStatusFilterChange">{{item.label}}</view>
  </view>

  <view class="stat-bar"><text class="stat-text">共 {{total}} 位用户</text></view>

  <scroll-view class="body" scroll-y="{{true}}" show-scrollbar="{{false}}" enhanced="{{true}}" bounces="{{false}}"
    refresher-enabled="{{true}}" refreshertriggered="{{refreshing}}" bindrefresherrefresh="onRefresh"
    bindscrolltolower="onLoadMore" lower-threshold="80">

    <!-- ==================== Tab 1：基础管理 ==================== -->
    <block wx:if="{{activeTab === 'basic'}}">
      <view class="user-card" wx:for="{{users}}" wx:key="id" wx:for-item="u">
        <view class="uc-head">
          <view class="uc-avatar"><text class="uc-avatar-icon">人</text></view>
          <view class="uc-info">
            <view class="uc-name-row">
              <text class="uc-nick">{{u.nickName || '-'}}</text>
              <text class="badge badge-role">{{u._roleLabel}}</text>
              <text class="badge badge-status">{{u._statusLabel}}</text>
            </view>
            <text class="uc-line">世慧号：{{u.qlId || u.id}}</text>
            <text class="uc-line">显示名：{{u.displayName || '-'}}</text>
            <text class="uc-line">手机号：{{u.phone || '-'}}</text>
            <text class="uc-line">注册时间：{{u._time}}</text>
          </view>
        </view>
        <view class="uc-actions">
          <view class="act" data-index="{{index}}" bindtap="onEditOpen">编辑</view>
          <view class="act" data-index="{{index}}" bindtap="onProfileOpen">完善资料</view>
          <view class="act act-warn" data-index="{{index}}" bindtap="onPwdOpen">重置密码</view>
          <view class="act act-danger" wx:if="{{u.status === 'deleted'}}" data-index="{{index}}" bindtap="onPermanentDelete">永久删除</view>
        </view>
      </view>
    </block>

    <!-- ==================== Tab 2：状态控制 ==================== -->
    <block wx:if="{{activeTab === 'status'}}">
      <view class="user-card" wx:for="{{users}}" wx:key="id" wx:for-item="u">
        <view class="uc-head">
          <view class="uc-avatar"><text class="uc-avatar-icon">人</text></view>
          <view class="uc-info">
            <view class="uc-name-row">
              <text class="uc-nick">{{u.nickName || '-'}}</text>
              <text class="badge badge-status">{{u._statusLabel}}</text>
            </view>
            <text class="uc-line">世慧号：{{u.qlId || u.id}}</text>
            <text class="uc-line">显示名：{{u.displayName || '-'}}</text>
            <text class="uc-line">注册时间：{{u._time}}</text>
          </view>
        </view>
        <view class="uc-actions">
          <block wx:if="{{u.status === 'active'}}">
            <view class="act" data-id="{{u.id}}" data-status="disabled" bindtap="onSetStatus">禁用</view>
            <view class="act act-warn" data-id="{{u.id}}" data-status="banned" bindtap="onSetStatus">拉黑</view>
          </block>
          <view class="act act-ok" wx:if="{{u.status === 'disabled'}}" data-id="{{u.id}}" data-status="active" bindtap="onSetStatus">启用</view>
          <view class="act act-ok" wx:if="{{u.status === 'banned'}}" data-id="{{u.id}}" data-status="active" bindtap="onSetStatus">解封</view>
          <view class="act act-danger" wx:if="{{u.status !== 'deleted'}}" data-id="{{u.id}}" data-status="deleted" bindtap="onSetStatus">注销</view>
          <view class="act act-danger-hard" wx:if="{{u.status === 'deleted'}}" data-index="{{index}}" bindtap="onPermanentDelete">永久删除</view>
        </view>
      </view>
    </block>

    <!-- ==================== Tab 3：权限管理 ==================== -->
    <block wx:if="{{activeTab === 'permission'}}">
      <view class="user-card" wx:for="{{users}}" wx:key="id" wx:for-item="u">
        <view class="uc-head">
          <view class="uc-avatar"><text class="uc-avatar-icon">人</text></view>
          <view class="uc-info">
            <view class="uc-name-row">
              <text class="uc-nick">{{u.nickName || '-'}}</text>
              <text class="badge badge-role">{{u._roleLabel}}</text>
              <text class="badge badge-admin" wx:if="{{u._admin}}">管理员</text>
            </view>
            <text class="uc-line">世慧号：{{u.qlId || u.id}}</text>
            <text class="uc-line">显示名：{{u.displayName || '-'}}</text>
          </view>
        </view>
        <view class="uc-role-row">
          <text class="uc-role-label">分配角色</text>
          <picker mode="selector" range="{{roleLabels}}" value="{{u._roleIndex}}" data-index="{{index}}" bindchange="onRolePick">
            <view class="role-pick">{{u._roleLabel}} ▾</view>
          </picker>
        </view>
        <view class="uc-actions">
          <view class="act" data-index="{{index}}" bindtap="onToggleAdmin">{{u._admin ? '取消管理员' : '设为管理员'}}</view>
        </view>
      </view>
    </block>

    <view class="empty-state" wx:if="{{!loading && users.length === 0}}">
      <text class="empty-text">暂无用户数据</text>
    </view>
    <view class="loading-more" wx:if="{{loading}}">加载中…</view>
    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- ==================== 表单弹窗（新增 / 编辑 / 完善资料） ==================== -->
  <view class="modal-overlay" wx:if="{{showForm}}" bindtap="onCloseForm">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">{{formTitle}}</text>
        <text class="modal-close" bindtap="onCloseForm">✕</text>
      </view>
      <scroll-view class="modal-body" scroll-y="{{true}}" show-scrollbar="{{false}}" enhanced="{{true}}" bounces="{{false}}">
        <view class="form-group">
          <text class="form-label">昵称</text>
          <input class="form-input" placeholder="昵称" value="{{form.nickName}}" data-field="nickName" bindinput="onFormInput" />
        </view>
        <view class="form-group">
          <text class="form-label">显示名</text>
          <input class="form-input" placeholder="显示名" value="{{form.displayName}}" data-field="displayName" bindinput="onFormInput" />
        </view>
        <view class="form-group">
          <text class="form-label">手机号</text>
          <input class="form-input" type="number" maxlength="11" placeholder="手机号" value="{{form.phone}}" data-field="phone" bindinput="onFormInput" />
        </view>
        <view class="form-group">
          <text class="form-label">邮箱</text>
          <input class="form-input" placeholder="邮箱" value="{{form.email}}" data-field="email" bindinput="onFormInput" />
        </view>

        <!-- 新增模式：密码 + 角色 -->
        <block wx:if="{{formMode === 'create'}}">
          <view class="form-group">
            <text class="form-label">密码（可留空）</text>
            <input class="form-input" password placeholder="留空则暂不设置密码" value="{{form.password}}" data-field="password" bindinput="onFormInput" />
          </view>
          <view class="form-group">
            <text class="form-label">角色</text>
            <picker mode="selector" range="{{roleLabels}}" value="{{roleIndex}}" bindchange="onFormRoleChange">
              <view class="form-input form-picker">{{roleLabels[roleIndex]}}</view>
            </picker>
          </view>
        </block>

        <!-- 完善资料模式：世慧号 + 备注 -->
        <block wx:if="{{formMode === 'profile'}}">
          <view class="form-group">
            <text class="form-label">世慧号（qlId）</text>
            <input class="form-input" placeholder="8 位世慧号" value="{{form.qlId}}" data-field="qlId" bindinput="onFormInput" />
          </view>
          <view class="form-group">
            <text class="form-label">管理员备注</text>
            <textarea class="form-textarea" placeholder="仅管理员可见" value="{{form.remark}}" data-field="remark" bindinput="onFormInput" />
          </view>
        </block>
      </scroll-view>
      <view class="modal-footer">
        <view class="form-btn form-btn-cancel" bindtap="onCloseForm">取消</view>
        <view class="form-btn {{saving ? 'is-disabled' : ''}}" bindtap="onSubmitForm">{{saving ? '保存中…' : '保存'}}</view>
      </view>
    </view>
  </view>

  <!-- ==================== 重置密码弹窗 ==================== -->
  <view class="modal-overlay" wx:if="{{showPwdForm}}" bindtap="onClosePwdForm">
    <view class="modal-content modal-content-sm" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">重置密码 · {{pwdForm.name}}</text>
        <text class="modal-close" bindtap="onClosePwdForm">✕</text>
      </view>
      <view class="modal-body-fixed">
        <view class="warn-box">重置后该用户的登录密码立即变为新密码，请自行通知用户。</view>
        <view class="form-group">
          <text class="form-label">新密码（至少 6 位）</text>
          <input class="form-input" password placeholder="请输入新密码" value="{{pwdForm.newPassword}}" bindinput="onPwdInput" />
        </view>
      </view>
      <view class="modal-footer">
        <view class="form-btn form-btn-cancel" bindtap="onClosePwdForm">取消</view>
        <view class="form-btn form-btn-warn {{resetting ? 'is-disabled' : ''}}" bindtap="onSubmitResetPwd">{{resetting ? '重置中…' : '确认重置'}}</view>
      </view>
    </view>
  </view>
</view>
