page {
  background: var(--bg-primary);
  min-height: 100vh;
}

.page-wrapper { display:flex; flex-direction:column; height:100vh; box-sizing:border-box; }
.nav-bar { flex-shrink:0; background:var(--bg-elevated); border-bottom:1rpx solid var(--border-subtle); padding-top:88rpx; position:sticky; top:0; z-index:100; }
.nav-inner { display:flex; align-items:center; height:44px; padding:0 16px; }
.nav-back { display:flex; align-items:center; gap:4rpx; padding:8rpx 16rpx; flex-shrink:0; }
.back-arrow { font-size: var(--fs-40); color: var(--accent-gold-ink); line-height:1; }
.back-text { font-size: var(--fs-28); color: var(--accent-gold-ink); }
.nav-title { flex:1; text-align:center; font-size: var(--fs-32); font-weight:700; color:var(--text-primary); letter-spacing: 0; }
.nav-right { width:120rpx; flex-shrink:0; display:flex; justify-content:center; }

.search-bar { flex-shrink:0; display:flex; align-items:center; gap:16rpx; padding:16rpx 24rpx; background:var(--bg-elevated); border-bottom:1rpx solid var(--border-subtle); }
.search-input-wrap { flex:1; display:flex; align-items:center; background:var(--bg-deep); border-radius: var(--radius); padding:0 20rpx; height:64rpx; }
.search-icon { font-size: var(--fs-28); margin-right:12rpx; flex-shrink:0; }
.search-input { flex:1; font-size: var(--fs-26); color:var(--text-primary); height:100%; }
.topic-filter { flex-shrink:0; }
.topic-filter picker { display:flex; align-items:center; gap:8rpx; padding:12rpx 20rpx; background:var(--bg-deep); border-radius: var(--radius); height:64rpx; box-sizing:border-box; }
.filter-label { font-size: var(--fs-24); color:var(--text-secondary); }
.filter-arrow { font-size: var(--fs-20); color:var(--text-muted); }

.content-scroll { flex:1; overflow:scroll; -webkit-overflow-scrolling:touch; }
.article-list { padding:16rpx 20rpx; display:flex; flex-direction:column; gap:12rpx; }

.article-item { display:flex; align-items:center; justify-content:space-between; padding:20rpx; background:var(--bg-card); border:1rpx solid var(--border-subtle); border-radius: var(--radius); box-shadow:var(--shadow-card); }
.article-item:active { transform:scale(0.99); border-color:var(--border-color); }

.article-info { display:flex; align-items:flex-start; gap:16rpx; flex:1; min-width:0; }
.article-main { display:flex; flex-direction:column; gap:6rpx; min-width:0; }
.article-title-row { display:flex; align-items:center; gap:8rpx; }
.article-seq { font-size: var(--fs-24); font-weight:700; color: var(--accent-gold-ink);  flex-shrink:0; min-width:48rpx; }
.article-title { font-size: var(--fs-28); font-weight:700; color:var(--text-primary); letter-spacing: 0; }
.pinned-badge { font-size: var(--fs-24); }
.article-meta { display:flex; align-items:center; gap:8rpx; flex-wrap:wrap; }
.meta-tag { font-size: var(--fs-20); color: var(--accent-gold-ink); background:rgba(181, 113, 58,0.08); padding:2rpx 14rpx; border-radius:12rpx; }
.meta-text { font-size: var(--fs-20); color:var(--text-muted); }
.article-summary { font-size: var(--fs-22); color:var(--text-muted); line-height:1.5; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }

.article-actions { display:flex; align-items:center; flex-wrap:wrap; justify-content:flex-end; gap:12rpx; flex-shrink:0; margin-left:16rpx; max-width:320rpx; }
.action-btn { font-size: var(--fs-24); padding:8rpx 20rpx; border-radius:12rpx; text-align:center; line-height:1; }
.action-edit { color: var(--accent-gold-ink); background:rgba(181, 113, 58,0.08); }
.action-edit:active { background:rgba(181, 113, 58,0.16); }
.action-delete { color:#f87171; background:rgba(248, 113, 113,0.08); }
.action-delete:active { background:rgba(248, 113, 113,0.16); }
.action-pin { color: var(--accent-gold-ink); background:rgba(181, 113, 58,0.06); border:1rpx solid rgba(181, 113, 58,0.18); }
.action-pin:active { background:rgba(181, 113, 58,0.16); }

.empty-state { display:flex; justify-content:center; padding:80rpx 0; }
.empty-text { font-size: var(--fs-28); color:var(--text-muted); }
.loading-more { display:flex; justify-content:center; padding:24rpx 0; font-size: var(--fs-24); color:var(--text-muted); }
.bottom-spacer { height:calc(120rpx + env(safe-area-inset-bottom)); }

.fab-btn { position:fixed; right:32rpx; bottom:calc(48rpx + env(safe-area-inset-bottom)); display:flex; align-items:center; gap:8rpx; padding:20rpx 32rpx; background:var(--accent-gold); border-radius:40rpx; box-shadow:0 4rpx 20rpx rgba(181, 113, 58,0.3); z-index:50; }
.fab-btn:active { transform:scale(0.95); opacity:0.9; }
.fab-icon { font-size: var(--fs-32); color:#fff; line-height:1; }
.fab-text { font-size: var(--fs-28); font-weight:600; color:#fff; letter-spacing: 0; }

.modal-overlay { position:fixed; top:0; left:0; right:0; bottom:0; z-index:200; background:rgba(181, 113, 58,0.4); display:flex; align-items:flex-end; justify-content:center; }
.modal-content { width:100%; max-height:85vh; background:var(--bg-primary); border-radius:24rpx 24rpx 0 0; display:flex; flex-direction:column; }
.modal-header { flex-shrink:0; display:flex; align-items:center; justify-content:space-between; padding:28rpx 32rpx; border-bottom:1rpx solid var(--border-subtle); }
.modal-title { font-size: var(--fs-34); font-weight:700; color:var(--text-primary); letter-spacing: 0; }
.modal-close { font-size: var(--fs-32); color:var(--text-muted); padding:8rpx; width:48rpx; height:48rpx; text-align:center; line-height:48rpx; border-radius:50%; background:rgba(181, 113, 58,0.06); }
.modal-close:active { background:rgba(181, 113, 58,0.12); }
.modal-body { flex:1; overflow:scroll; -webkit-overflow-scrolling:touch; padding:24rpx 32rpx; }
.form-group { margin-bottom:24rpx; }
.form-label { display:block; font-size: var(--fs-26); font-weight:600; color:var(--text-primary); margin-bottom:10rpx; }
.form-label.required::after { content:' *'; color:#f87171; }
.form-input { width:100%; height:72rpx; padding:0 20rpx; background:var(--bg-card); border:1rpx solid var(--border-subtle); border-radius:12rpx; font-size: var(--fs-26); color:var(--text-primary); box-sizing:border-box; }
.form-picker { display:flex; align-items:center; line-height:72rpx; }
.form-textarea { width:100%; height:120rpx; padding:16rpx 20rpx; background:var(--bg-card); border:1rpx solid var(--border-subtle); border-radius:12rpx; font-size: var(--fs-26); color:var(--text-primary); box-sizing:border-box; line-height:1.5; }
.form-textarea-lg { height:240rpx; }
.form-row { display:flex; gap:20rpx; }
.form-half { flex:1; min-width:0; }
.modal-footer { flex-shrink:0; display:flex; gap:20rpx; padding:24rpx 32rpx; padding-bottom:calc(24rpx + env(safe-area-inset-bottom)); border-top:1rpx solid var(--border-subtle); }
.form-btn { flex:1; height:80rpx; line-height:80rpx; text-align:center; border-radius: var(--radius); font-size: var(--fs-30); font-weight:600; letter-spacing: 0; }
.form-btn-cancel { color:var(--text-secondary); background:var(--bg-deep); }
.form-btn-cancel:active { background:var(--border-subtle); }
.form-btn-submit { color:#fff; background:var(--accent-gold); }
.form-btn-submit:active { opacity:0.9; }

/* ===== 全屏正文编辑器 ===== */
.fullscreen-editor {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 300;
  background: var(--bg-primary);
  display: flex;
  flex-direction: column;
}

.fullscreen-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 24rpx;
  padding-top: 130rpx;
  background: var(--bg-elevated);
  border-bottom: 1rpx solid var(--border-subtle);
  flex-shrink: 0;
}

.fullscreen-title {
  font-size: var(--fs-32);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0;
}

.fullscreen-done {
  font-size: var(--fs-28);
  color: var(--accent-gold-ink);
  font-weight: 600;
  padding: 8rpx 16rpx;
}

.fullscreen-done:active {
  opacity: 0.7;
}

.fullscreen-textarea {
  flex: 1;
  width: 100%;
  padding: 40rpx 32rpx 32rpx;
  font-size: var(--fs-28);
  color: var(--text-primary);
  background: transparent;
  line-height: 1.8;
  box-sizing: border-box;
  border: none;
  outline: none;
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.form-label-action {
  font-size: var(--fs-24);
  color: var(--accent-gold-ink);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(181, 113, 58,0.06);
}

.form-label-action:active {
  background: rgba(181, 113, 58,0.14);
}

/* ===== 相关人物：已选标签（上方）+ 搜索候选（下方） ===== */
.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.chip-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 16rpx 8rpx 20rpx;
  background: rgba(181, 113, 58, 0.1);
  border-radius: 24rpx;
}

.chip-text {
  font-size: var(--fs-24);
  color: var(--accent-gold-ink);
}

.chip-x {
  font-size: var(--fs-22);
  color: var(--text-muted);
  padding: 0 6rpx;
}

/* 候选列表：用 flex + gap 排布，避免依赖 :first-child 这类结构伪类 */
.cand-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 12rpx;
}

.cand-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  background: var(--bg-deep);
  border-radius: 12rpx;
}

.cand-item:active {
  background: rgba(181, 113, 58, 0.12);
}

.cand-name {
  font-size: var(--fs-26);
  color: var(--text-primary);
}

.cand-meta {
  flex-shrink: 0;
  font-size: var(--fs-22);
  color: var(--text-muted);
}

/* ===== 文献引用：每条一张小卡片 ===== */
.cite-card {
  margin-top: 12rpx;
  padding: 20rpx;
  background: var(--bg-deep);
  border-radius: 12rpx;
}

.cite-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.cite-no {
  font-size: var(--fs-24);
  font-weight: 600;
  color: var(--text-secondary);
}

.cite-del {
  font-size: var(--fs-24);
  color: #f87171;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(248, 113, 113, 0.08);
}

/* 引用卡片里的输入框放在深色底上，用卡片浅色区分 */
.cite-input {
  margin-bottom: 12rpx;
  background: var(--bg-card);
}

.cite-card .form-row {
  display: flex;
  gap: 12rpx;
}

.cite-card .form-half {
  flex: 1;
  min-width: 0;
}

/* ===== 提示行 ===== */
.hint-line {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-22);
  color: var(--text-muted);
  line-height: 1.5;
}
