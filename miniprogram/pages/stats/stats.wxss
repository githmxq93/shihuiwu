/* 实时看板 · B 章节叙事（按 _design/dashboard 恢复版落码）
   口径：
   1) 375 设计稿 ×2 = rpx，所有 rpx 都取偶数；分隔线用 1px（rpx 偶数约束不适用于非 2 倍像素线）。
   2) letter-spacing 全部为 0。
   3) 承载正文/注释的文字统一 --text-secondary(#6e5d48，纸底 5.4:1)；
      金色小字统一 #8f5326(5.3:1)，不用 #75654f(3.7:1) / #b5713a(3.3:1) 做小字。 */

.st-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-primary);
  color: var(--text-primary);
}

.page-scroll {
  flex: 1;
  height: 100vh;
  min-height: 0;
}

/* ===== 页头（mast） ===== */

.hero {
  padding: 12rpx 32rpx 16rpx;
}

.hero-badge {
  display: inline-block;
  padding: 2rpx 16rpx;
  border: 1px solid rgba(181, 113, 58, 0.35);
  border-radius: 1000rpx;
  font-size: 18rpx;
  line-height: 1.6;
  color: var(--accent-gold-ink);
}

.hero-title {
  margin-top: 10rpx;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 58rpx;
  font-weight: 900;
  letter-spacing: 0;
  line-height: 1.2;
}

.hero-title-accent {
  color: var(--accent-gold-ink);
}

.hero-subtitle {
  margin-top: 8rpx;
  font-size: var(--fs-20);
  color: var(--text-secondary);
}

/* ===== 吸顶章节条 ===== */

.chapters {
  display: flex;
  gap: 8rpx;
  padding: 14rpx 28rpx 0;
  background: var(--bg-primary);
}

/* 固定在导航下方（top 由 WXML 按 navH 注入），同高占位在文档流里防跳动。
 * z-index 70：高于窄条 60 与顶部遮罩 55，低于 nav-bar 100 —— 三条各占一段高度，互不遮挡 */
.chapters--fixed {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 70;
  padding-bottom: 2rpx;
  border-bottom: 1px solid rgba(181, 113, 58, 0.14);
  box-shadow: 0 2rpx 12rpx -8rpx rgba(90, 70, 40, 0.35);
}

/* ===== 顶部不透明遮罩（0 → navH） =====
 * nav-bar 自身背景是「不透明 → 底部 40% 渐隐透明」的渐变，而整页是 scroll-view、
 * 正文能滚到屏幕最顶端，所以要在它下面补一层实底，否则导航条下半段会透出正在滚动的数字。
 * z-index 55：高于滚动内容（static，z=0），低于窄条 60 / 章节条 70 / nav-bar 100。
 * 高度由 WXML 内联 navH 注入（safeAreaTop + 44），不用 100vh，避免矮屏多盖正文。 */
.top-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 55;
  background: var(--bg-primary);
}

/* ===== 收起态窄标题条（44px = 88rpx） =====
 * fixed 覆盖，不进文档流：出现/消失只改 opacity / transform，高度恒定 88rpx，
 * 所以滚动过程中 scrollTop 与各段 offsetTop 都不受影响（不需要二次重测）。
 * 层叠：顶部遮罩 55 < 窄条 60 < 章节条 70 < nav-bar 100，三条互不遮挡。
 * 关闭态 pointer-events:none，手指滑动照常穿透到下面的 scroll-view。 */
.stick-hd {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  box-sizing: border-box;
  background: var(--bg-primary);
  border-bottom: 1px solid rgba(181, 113, 58, 0.14);
  box-shadow: 0 2rpx 12rpx -8rpx rgba(90, 70, 40, 0.35);
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: var(--fs-34);
  font-weight: 900;
  letter-spacing: 0;
  line-height: 1;
  color: var(--text-primary);
  opacity: 0;
  transform: translateY(-12rpx);
  transition: opacity 0.2s ease, transform 0.2s ease;
  pointer-events: none;
}

.stick-hd.on {
  opacity: 1;
  transform: translateY(0);
}

.stick-hd-accent {
  color: var(--accent-gold-ink);
}

.chap {
  position: relative;
  flex: 1;
  text-align: center;
  padding: 10rpx 0 14rpx;
  font-size: var(--fs-22);
  color: var(--text-secondary);
  border-bottom: 2px solid transparent;
}

/* 章节页签：整块视觉高度不足 88rpx，透明层补到 44px；
   章节条上下留白 14rpx / 2rpx，超出部分仅约 3rpx，不压到下方内容。 */
.chap::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

.chap.on {
  color: var(--text-primary);
  font-weight: 700;
  border-bottom-color: var(--accent-gold-ink);
}

.chap-name {
  font-size: var(--fs-22);
}

.chap-sub {
  margin-top: 2rpx;
  font-size: 16rpx;
  font-weight: 400;
  color: var(--text-secondary);
}

.chap-ph {
  height: 92rpx;
}

/* ===== 章节内容容器 ===== */

.content {
