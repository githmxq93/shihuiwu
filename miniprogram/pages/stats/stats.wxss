  min-width: 0;
  font-size: 16rpx;
  color: var(--text-secondary);
}

.dback {
  position: relative;
  flex: none;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0;
  color: var(--accent-gold-ink);
}

/* 「收起」原为 18rpx 裸文字（约 9px 高）。改为 view 后向下外扩到 88rpx ×88rpx：
   向上顶到内层滚动框底部会抢滚动热区，所以热区贴着文字顶部向下延伸，
   下方落在虚线框留白与下一段标题上，均不可点。 */
.dback::after {
  content: '';
  position: absolute;
  left: -26rpx;
  top: 0;
  width: 88rpx;
  height: 88rpx;
}

