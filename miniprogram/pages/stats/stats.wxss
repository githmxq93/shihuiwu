  position: relative;
  margin: 0 28rpx;
  padding: 12rpx 18rpx 8rpx;
  border: 1px dashed rgba(181, 113, 58, 0.6);
  border-radius: 24rpx;
  background: rgba(255, 253, 247, 0.6);
}

.dgrid-scroll {
  height: 456rpx;
}

.dgrid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  column-gap: 18rpx;
}

.dg {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 6rpx;
  padding: 6rpx 0;
  border-bottom: 1px solid rgba(181, 113, 58, 0.08);
  font-size: 18rpx;
  white-space: nowrap;
  overflow: hidden;
}

.dg-n {
  overflow: hidden;
  text-overflow: ellipsis;
}

.dg-v {
  flex: none;
  font-size: 16rpx;
  font-weight: 600;
  color: var(--text-secondary);
  font-variant-numeric: tabular-nums;
}

.dg.hi .dg-v {
  color: var(--accent-gold-ink);
}

.dbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 4rpx;
  padding: 10rpx 0 6rpx;
  border-top: 1px solid rgba(181, 113, 58, 0.14);
}

.dbar-note {
