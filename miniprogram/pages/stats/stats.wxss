  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 52rpx;
  margin-top: 10rpx;
  border-radius: 14rpx;
  background: rgba(181, 113, 58, 0.07);
  color: var(--accent-gold-ink);
  font-size: var(--fs-20);
  font-weight: 700;
}

/* 「展开全部」视觉 52rpx，透明层补到 88rpx（44px）。
   上下各外扩 18rpx：上方落在说明文字上，下方落在虚线框内边距，均不可点。 */
.exbtn::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

.exbtn-hover {
  background: rgba(181, 113, 58, 0.14);
}

/* ===== 朝代构成：全部 60 个（三列网格，框内滚动） ===== */

