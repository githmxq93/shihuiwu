  text-overflow: ellipsis;
}

.ex-d {
  margin-left: 6rpx;
  font-size: 16rpx;
  font-weight: 400;
  color: var(--text-secondary);
}

/* ===== 实时动态 ===== */

.feed {
  margin: 0 32rpx;
  padding: 2rpx 20rpx;
  border: 1px solid rgba(181, 113, 58, 0.12);
  border-radius: 20rpx;
  background: var(--bg-card);
}

.feed-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1px solid rgba(181, 113, 58, 0.08);
}

.feed-item--last {
  border-bottom: 0;
}

.feed-badge {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 16rpx;
  line-height: 1.6;
  background: rgba(181, 113, 58, 0.12);
  color: var(--accent-gold-ink);
}

.feed-badge--add { background: rgba(110, 127, 75, 0.14); color: #55663a; }
.feed-badge--update { background: rgba(181, 113, 58, 0.14); color: var(--accent-gold-ink); }
.feed-badge--review { background: rgba(92, 122, 153, 0.14); color: #45607c; }

.feed-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-20);
  line-height: 1.4;
}

.feed-time {
  flex: none;
  padding-top: 2rpx;
  font-size: 16rpx;
  color: var(--text-secondary);
}

/* ===== 口径说明 ===== */

.lim {
  margin: 14rpx 32rpx 0;
  padding-left: 14rpx;
  border-left: 2px solid rgba(181, 113, 58, 0.32);
  font-size: 16rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.lim-b {
  color: var(--accent-gold-ink);
  font-weight: 600;
}

/* ===== 骨架屏 / 错误态 ===== */

.skeleton-wrap {
  padding: 24rpx 32rpx;
}

.skeleton-card {
  margin-bottom: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  background: var(--bg-card);
}

.skeleton-line {
  height: 20rpx;
  margin-bottom: 14rpx;
  border-radius: 10rpx;
  background: rgba(181, 113, 58, 0.1);
}

.skeleton-line-title {
  width: 40%;
  height: 28rpx;
}

.skeleton-line-short {
  width: 60%;
  margin-bottom: 0;
}

.skeleton-hint {
  padding: 20rpx 0;
  text-align: center;
  font-size: var(--fs-22);
  color: var(--text-secondary);
}

.error-retry {
  margin: 40rpx 32rpx;
  padding: 40rpx 32rpx;
  text-align: center;
  border: 1px solid rgba(181, 113, 58, 0.16);
  border-radius: 24rpx;
  background: var(--bg-card);
}

.error-retry-text {
  font-size: var(--fs-24);
  line-height: 1.6;
  color: var(--text-secondary);
}

.error-retry-btn {
  display: inline-block;
  height: 64rpx;
  margin-top: 24rpx;
  padding: 0 40rpx;
  border-radius: 32rpx;
  background: var(--accent-gold-ink);
  color: #fff7ec;
  font-size: var(--fs-24);
  line-height: 64rpx;
}

.bottom-spacer {
  height: calc(80rpx + env(safe-area-inset-bottom));
}
