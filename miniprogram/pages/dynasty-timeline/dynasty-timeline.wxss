/* ============================================================
   朝代时间轴 · B 案「分期索引」
   口径：/api/dynasties 现有 71 条 = 原 39 条 + 本轮补录 32 条
   （武周 1 / 五胡十六国 16 / 五代 5 / 十国 10，src='user'）。
   时间轴按 8 段分期排；并立用格子、相继用带序号的格子、
   多政权并存用可折叠列表。补录条目的 color 为 null，
   统一落到默认金色 #b5713a，不虚构设计色值。
   ============================================================ */

page {
  background: var(--bg-primary);
}

.dt-page {
  min-height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, -apple-system, sans-serif;
}

/* ---------- 固定深色头 ---------- */
.dt-head {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 90;
  padding-bottom: 8rpx;
  border-radius: 0 0 20rpx 20rpx;
  overflow: hidden;
  color: #fff7e8;
  background:
    radial-gradient(120% 90% at 84% 0%, rgba(207, 138, 75, 0.28), transparent 58%),
    linear-gradient(160deg, var(--head-grad-top) 0%, var(--head-grad-mid) 46%, var(--head-grad-bottom) 100%);
  box-shadow: 0 20rpx 48rpx -28rpx rgba(30, 20, 12, 0.7);
}
/* 原先这里有一层 115° 细斜纹（2rpx/6rpx 重复渐变，opacity .3）压在整个深色头上：
   高频条纹叠在文字下方，真机上会被读成"字发虚"的一部分，且不承载任何信息，已移除。 */
.dh-hero {
  position: relative;
  z-index: 1;
  padding: 10rpx 32rpx 0;
}
.dh-badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  border: 1rpx solid rgba(229, 183, 127, 0.35);
  border-radius: 999rpx;
  font-size: var(--fs-22);
  letter-spacing: 0;
  color: rgba(246, 236, 218, 0.88);
}
.dh-title {
  margin-top: 8rpx;
  font-family: "Noto Serif SC", "Songti SC", "STSong", serif;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.3;
}
.dh-accent {
  color: #e5b77f;
}
.dh-sub {
  margin-top: 6rpx;
  font-size: var(--fs-24);
  color: rgba(246, 236, 218, 0.78);
}

.era-strip {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  border-top: 1rpx solid rgba(229, 183, 127, 0.16);
  white-space: nowrap;
}
.era-row {
  display: flex;
  padding: 0 16rpx;
}
.era {
  flex: 1 0 auto;
  min-width: 96rpx;
  padding: 18rpx 4rpx;
  text-align: center;
  font-size: var(--fs-24);
  color: rgba(246, 236, 218, 0.76);
  border-top: 6rpx solid transparent;
  margin-top: -1rpx;
}
.era.on {
  color: #e5b77f;
  font-weight: 600;
  border-top-color: #e5b77f;
  background: rgba(229, 183, 127, 0.05);
}

/* ---------- 滚动区 ---------- */
.page-scroll {
  height: 100vh;
}
.head-spacer {
  width: 100%;
}
.secs {
  padding: 0 32rpx 48rpx;
}

/* ---------- 段头 ---------- */
.sec {
  position: relative;
}
.sec-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  padding: 28rpx 0 16rpx;
  border-bottom: 1rpx solid rgba(139, 115, 85, 0.16);
}
.sec-name {
  font-family: "Noto Serif SC", "Songti SC", "STSong", serif;
  font-size: var(--fs-32);
  font-weight: 800;
  letter-spacing: 0;
}
.sec-yr {
  margin-left: 16rpx;
  font-size: var(--fs-24);
  color: #6a5740;
}
.sec-cnt {
  margin-left: auto;
  font-size: var(--fs-22);
  color: #6a5740;
  white-space: nowrap;
}

/* ---------- 朝代行（可展开子段） ---------- */
.row-wrap {
  display: block;
}
.row {
  position: relative;
  display: flex;
  align-items: center;
  padding: 16rpx 0 16rpx 20rpx;
  border-bottom: 1rpx solid rgba(139, 115, 85, 0.09);
}
.row-bar {
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  border-radius: 4rpx;
}
.row-nm {
  font-family: "Noto Serif SC", "Songti SC", "STSong", serif;
  font-size: var(--fs-30);
  font-weight: 700;
  letter-spacing: 0;
  white-space: nowrap;
}
.row-tag {
  margin-left: 8rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  font-size: var(--fs-22);
  line-height: 1;
  color: #9a5a24;
  background: rgba(181, 113, 58, 0.09);
  white-space: nowrap;
}
.row-yr {
  margin-left: auto;
  font-size: var(--fs-24);
  font-weight: 600;
  color: #9a5a24;
  white-space: nowrap;
}
.row-len {
  width: 68rpx;
  text-align: right;
  font-size: var(--fs-22);
  color: #6a5740;
  white-space: nowrap;
}
.row-caret {
  width: 32rpx;
  text-align: center;
  font-size: var(--fs-24);
  color: #6a5740;
  transition: transform 0.18s;
}
.row.open .row-caret {
  transform: rotate(90deg);
}
.row.fold {
  border-bottom-style: dashed;
}

/* 子级：与「历代帝王」页一致的虚线左引导 */
.subs {
  margin: 0 0 12rpx 20rpx;
  padding-left: 20rpx;
  border-left: 1rpx dashed rgba(181, 113, 58, 0.32);
}
.sub-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx dotted rgba(139, 115, 85, 0.14);
}
.sub-row.deep {
  margin-left: 20rpx;
}
.sub-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex: none;
}
.sub-nm {
  font-size: var(--fs-26);
  color: #4a3826;
}
.sub-row.deep .sub-nm {
  color: var(--text-secondary);
}
.sub-yr {
  margin-left: auto;
  font-size: var(--fs-22);
  color: #6a5740;
  white-space: nowrap;
}
.sub-len {
  width: 68rpx;
  text-align: right;
  font-size: var(--fs-22);
  color: #6a5740;
}
.sub-note {
  padding: 10rpx 0 4rpx;
  font-size: var(--fs-22);
  line-height: 1.65;
  color: #6a5740;
}

/* ---------- 并立带 ---------- */
.band {
  margin: 20rpx 0 12rpx;
  border: 1rpx solid rgba(181, 113, 58, 0.2);
  border-radius: 20rpx;
  background: rgba(255, 252, 246, 0.62);
  overflow: hidden;
}
.band-h {
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx;
  border-bottom: 1rpx dashed rgba(181, 113, 58, 0.22);
  background: rgba(181, 113, 58, 0.05);
}
.band-k {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-size: var(--fs-22);
  letter-spacing: 0;
  color: #9a5a24;
  background: rgba(181, 113, 58, 0.13);
}
.band-title {
  margin-left: 12rpx;
  font-family: "Noto Serif SC", "Songti SC", "STSong", serif;
  font-size: var(--fs-26);
  font-weight: 700;
  letter-spacing: 0;
  color: #9a5a24;
}
.band-yr {
  margin-left: auto;
  font-size: var(--fs-22);
  color: #6a5740;
}
.cells {
  display: flex;
  flex-wrap: wrap;
}
.cell {
  position: relative;
  flex: 1 1 33.33%;
  min-width: 184rpx;
  padding: 16rpx 20rpx;
  border-right: 1rpx solid rgba(139, 115, 85, 0.1);
  border-bottom: 1rpx solid rgba(139, 115, 85, 0.1);
}
.cell:nth-child(3n),
.cell:last-child {
  border-right: 0;
}
.cell-hover {
  background: rgba(181, 113, 58, 0.05);
}
.cell-nm {
  display: flex;
  align-items: center;
  font-family: "Noto Serif SC", "Songti SC", "STSong", serif;
  font-size: var(--fs-28);
  font-weight: 700;
  letter-spacing: 0;
}
.cell-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex: none;
}
.cell-yr {
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: #6a5740;
}
.cell-len {
  margin-top: 4rpx;
  font-size: var(--fs-22);
  color: #6a5740;
}
.band-f {
  padding: 12rpx 20rpx;
  font-size: var(--fs-22);
  line-height: 1.6;
  color: #6a5740;
}

/* ---------- 五代：3+2 格子 + 右上角 1—5 序号 ---------- */
.cells.seqc .cell {
  flex: 1 1 33.33%;
  padding: 20rpx 20rpx 16rpx;
}
.cell-ord {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-22);
  font-weight: 700;
  color: #fff7e8;
}
.seq-tip {
  padding: 10rpx 20rpx 6rpx;
  font-size: var(--fs-22);
  line-height: 1.55;
  color: #6a5740;
}

/* ---------- 乙案列表（十六国 / 十国） ---------- */
.lrow {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid rgba(139, 115, 85, 0.09);
  border-left: 6rpx solid transparent;
}
.lrow:last-child {
  border-bottom: 0;
}
.lrow-start {
  width: 88rpx;
  flex: none;
  font-size: var(--fs-22);
  color: #6a5740;
}
.lrow-nm {
  font-family: "Noto Serif SC", "Songti SC", "STSong", serif;
  font-size: var(--fs-26);
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.lrow-sp {
  margin-left: auto;
  font-size: var(--fs-22);
  color: #9a5a24;
  white-space: nowrap;
}
.lrow-len {
  width: 68rpx;
  flex: none;
  text-align: right;
  font-size: var(--fs-22);
  color: #6a5740;
}
.lrow.g1 {
  border-left-color: #8b5cf6;
}
.lrow.g1 .lrow-start {
  color: #7c3aed;
  background: rgba(124, 58, 237, 0.11);
  border-radius: 6rpx;
  font-weight: 600;
  text-align: center;
}
.lrow.g2 {
  border-left-color: #0d9488;
}
.lrow.g2 .lrow-start {
  color: #0f766e;
  background: rgba(13, 148, 136, 0.12);
  border-radius: 6rpx;
  font-weight: 600;
  text-align: center;
}
.lrow.g3 {
  border-left-color: var(--accent-gold-ink);
}
.lrow.g3 .lrow-start {
  color: #9a5a24;
  background: rgba(181, 113, 58, 0.12);
  border-radius: 6rpx;
  font-weight: 600;
  text-align: center;
}
.lrow.g4 {
  border-left-color: #be123c;
}
.lrow.g4 .lrow-start {
  color: #be123c;
  background: rgba(190, 18, 60, 0.1);
  border-radius: 6rpx;
  font-weight: 600;
  text-align: center;
}

/* ---------- 段内说明 / 页脚 ---------- */
.rg-note {
  margin: 12rpx 0 4rpx;
  font-size: var(--fs-22);
  line-height: 1.65;
  color: #6a5740;
}
.foot {
  padding: 36rpx 36rpx 12rpx;
  font-size: var(--fs-22);
  line-height: 1.7;
  text-align: center;
  color: #6a5740;
}

/* ---------- 加载 / 失败 / 空 ---------- */
.skeleton-wrap {
  padding: 32rpx;
}
.skeleton-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 252, 246, 0.7);
  border: 1rpx solid rgba(139, 115, 85, 0.12);
}
.skeleton-line {
  height: 20rpx;
  margin-bottom: 14rpx;
  border-radius: 10rpx;
  background: rgba(139, 115, 85, 0.14);
}
.skeleton-line-title {
  width: 40%;
  height: 28rpx;
}
.skeleton-line-short {
  width: 62%;
  margin-bottom: 0;
}
.skeleton-hint {
  text-align: center;
  font-size: var(--fs-24);
  color: #6a5740;
}
.error-retry,
.empty-state {
  padding: 140rpx 48rpx;
  text-align: center;
}
.error-retry-text,
.empty-text {
  font-size: var(--fs-26);
  color: #6a5740;
}
.error-retry-btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 14rpx 44rpx;
  border-radius: 999rpx;
  font-size: var(--fs-26);
  color: #fff7e8;
  background: var(--accent-gold);
}

/* ---------- 详情抽屉 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(30, 20, 12, 0.42);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s;
}
.mask.on {
  opacity: 1;
  pointer-events: auto;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 210;
  padding: 12rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius-lg) 28rpx 0 0;
  background: var(--bg-card);
  box-shadow: 0 -20rpx 48rpx rgba(52, 38, 24, 0.18);
  transform: translateY(110%);
  transition: transform 0.24s ease;
}
.sheet.on {
  transform: translateY(0);
}
.sheet-bar {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: rgba(139, 115, 85, 0.25);
}
.sheet-top {
  display: flex;
  align-items: flex-start;
}
.sheet-title-wrap {
  flex: 1;
  min-width: 0;
}
.sheet-name {
  font-family: "Noto Serif SC", "Songti SC", "STSong", serif;
  font-size: var(--fs-36);
  font-weight: 800;
  letter-spacing: 0;
}
.sheet-span {
  margin-top: 6rpx;
  font-size: var(--fs-24);
  color: #6a5740;
}
.sheet-close {
  margin-left: auto;
  padding: 8rpx 22rpx;
  border: 1rpx solid rgba(139, 115, 85, 0.2);
  border-radius: 999rpx;
  font-size: var(--fs-24);
  color: #6a5740;
}
.sheet-cap {
  margin-top: 10rpx;
  font-size: var(--fs-24);
  color: #6a5740;
}
.sheet-body {
  margin-top: 14rpx;
  max-height: 42vh;
}
.sheet-brief {
  padding: 14rpx 18rpx;
  margin-bottom: 14rpx;
  border-left: 4rpx solid rgba(181, 113, 58, 0.45);
  background: rgba(181, 113, 58, 0.06);
  font-size: var(--fs-26);
  line-height: 1.7;
  color: #4a3826;
}
.sheet-detail {
  font-size: var(--fs-26);
  line-height: 1.9;
  color: var(--text-secondary);
  white-space: pre-wrap;
}
