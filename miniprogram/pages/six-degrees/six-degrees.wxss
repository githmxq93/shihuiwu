/* 六度空间 · 方案 D（A+C 组合）
   ------------------------------------------------------------
   设计基准 375×812，1px = 2rpx。全文件统一 letter-spacing: 0；
   所有 rpx 数值取偶数；正文文字对比度 ≥ 4.5:1（ink3 用 #75654f）。 */

.sd-page {
  --bg: #f4ede1;
  --card: #fbf7ef;
  --card-2: #f7f0e3;
  --ink: #33261a;
  --ink-2: #4a3826;
  --ink-3: var(--text-muted);
  --gold: #8a5a2c;
  --gold-deep: #6f4520;
  --red: #a63b2a;
  --red-deep: #8f3122;
  --line: rgba(61, 46, 31, 0.14);
  --line-strong: #d8c7ad;

  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
  font-family: "Songti SC", "Noto Serif CJK SC", "STSong", serif;
  letter-spacing: 0;
}

/* ---------------- 深色头 ---------------- */
.sd-head {
  flex: none;
  background: linear-gradient(160deg, #2e241a 0%, #3b2c1f 62%, #4a3625 100%);
  color: var(--tile-deep-text);
  box-shadow: 0 8rpx 24rpx rgba(46, 36, 26, 0.18);
  z-index: 20;
}

.nav {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.chev {
  font-size: 48rpx;
  line-height: 1;
  color: var(--tile-deep-text);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--fs-32);
  font-weight: 700;
  color: #f8f2e6;
}

.nav-spacer {
  width: 64rpx;
  height: 64rpx;
}

/* ---------------- 主体 ---------------- */
.sd-main {
  flex: 1;
  height: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* ---------------- 上浮双端搜索卡 ---------------- */
.search-wrap {
  flex: none;
  position: relative;
  padding: 20rpx 24rpx 0;
  z-index: 12;
}

.search-card {
  display: flex;
  align-items: stretch;
  padding: 20rpx 20rpx 20rpx 24rpx;
  background: var(--card);
  border: 2rpx solid rgba(61, 46, 31, 0.10);
  border-radius: var(--radius-lg);
  box-shadow: 0 16rpx 40rpx rgba(61, 46, 31, 0.10), 0 2rpx 6rpx rgba(61, 46, 31, 0.05);
}

.fields {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.field {
  position: relative;
  height: 76rpx;
  display: flex;
  align-items: center;
  background: #fffdf8;
  border: 2rpx solid #e4d7c3;
  border-radius: 18rpx;
  padding: 0 18rpx;
}

.field + .field {
  margin-top: 12rpx;
}

.dot {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #f1e2c4;
  color: #7a4a1e;
  font-size: var(--fs-20);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fi {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: var(--fs-30);
  color: var(--ink);
  letter-spacing: 0;
}

.ph {
  color: #8a7a66;
  font-size: var(--fs-26);
}

.clr {
  position: relative;
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: #eee3d2;
  color: #7a6650;
  font-size: var(--fs-26);
  line-height: 40rpx;
  text-align: center;
}

/* 清空：视觉仍 40rpx 圆点，热区 74×88rpx（37×44px）。
   右侧只有输入框内边距 18rpx + 与搜索侧栏的间距 18rpx，再右会压到「交换」；
   左侧是输入框，不扩。宽度受这两个夹缝限制，属 17 处中宽度未到 44px 的三处之一。 */
.clr::after {
  content: '';
  position: absolute;
  left: 0;
  right: -34rpx;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

.search-side {
  flex: none;
  width: 116rpx;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.swap {
  position: relative;
  height: 64rpx;
  border-radius: 18rpx;
  border: 2rpx solid #e0d2bd;
  background: #f7efe2;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 交换：视觉 64rpx 高，热区补到 88rpx（44px），宽度本就是 116rpx；
   上下各 12rpx，与下方「搜索」按钮间距 16rpx，仍留 4rpx。 */
.swap::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

.swap:active {
  background: #efe3d0;
}

.swap-i {
  font-size: var(--fs-32);
  color: var(--ink-2);
}

.go {
  height: 84rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--red-deep), var(--red));
  color: #fff7ec;
  font-size: var(--fs-28);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(166, 59, 42, 0.28);
}

.go:active {
  transform: scale(0.97);
}

.go.off {
  background: #cfc3b4;
  color: #f7f0e6;
  box-shadow: none;
}

.search-note {
  padding: 12rpx 8rpx 0;
  font-size: var(--fs-20);
  color: var(--ink-3);
}

/* 联想下拉 */
.dropdown {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  margin-top: 8rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: 0 16rpx 36rpx rgba(61, 46, 31, 0.18);
  z-index: 40;
  overflow: hidden;
}

.dd-item {
  padding: 18rpx 20rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  border-bottom: 2rpx solid rgba(220, 209, 193, 0.45);
}

.dd-item:active {
  background: #f3eadb;
}

.dd-name {
  font-size: var(--fs-28);
  color: var(--ink);
}

.dd-meta {
  font-size: var(--fs-20);
  color: var(--ink-3);
}

.dd-hint {
  padding: 18rpx 20rpx;
  font-size: var(--fs-24);
  line-height: 1.5;
  color: var(--ink-3);
}

/* ---------------- 结果头 ---------------- */
.rhead {
  flex: none;
  height: 70rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rh-main {
  font-size: var(--fs-26);
  color: var(--ink-2);
}

.rh-n {
  font-size: var(--fs-34);
  font-weight: 700;
  color: var(--red);
  padding: 0 4rpx;
}

.rh-sub {
  font-size: var(--fs-20);
  color: var(--ink-3);
}

/* ---------------- 路径列表 ---------------- */
.rlist {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.ritem {
  margin-bottom: 16rpx;
  background: var(--card);
  border: 2rpx solid #e6dac6;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 16rpx rgba(61, 46, 31, 0.05);
}

.ritem.open {
  border-color: #d9c3a2;
  box-shadow: 0 10rpx 24rpx rgba(61, 46, 31, 0.08);
}

.rrow {
  height: 108rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.rno {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #f1e2c4;
  color: #7a4a1e;
  font-size: var(--fs-20);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ritem.p0 .rno {
  background: var(--red);
  color: #fff;
}

.rbody {
  flex: 1;
  min-width: 0;
}

.rt1 {
  font-size: var(--fs-28);
  font-weight: 700;
  color: var(--ink);
}

.rt2 {
  margin-top: 6rpx;
  font-size: var(--fs-22);
  color: var(--ink-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rchev {
  flex: none;
  width: 40rpx;
  text-align: right;
  font-size: var(--fs-22);
  color: #8a6a46;
}

/* 展开区：44px 紧凑链 + 链尾两个动作 */
.rexp {
  padding: 4rpx 20rpx 20rpx;
  border-top: 2rpx solid #ece0cd;
}

.chain {
  padding: 14rpx 0 6rpx;
}

.cnode {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 14rpx;
  background: #fffdf8;
  border: 2rpx solid #e8dcc8;
  border-radius: var(--radius);
}

.cav {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #fdfbf7, #ebdfcd);
  border: 2rpx solid #d4c4b0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.cav-img {
  width: 100%;
  height: 100%;
}

.cav-char {
  font-size: var(--fs-26);
  font-weight: 700;
  color: #5c4b3b;
}

.cinfo {
  flex: 1;
  min-width: 0;
}

.cnm {
  font-size: var(--fs-26);
  font-weight: 700;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.csub {
  margin-top: 2rpx;
  font-size: var(--fs-20);
  color: var(--ink-3);
}

.cflag {
  flex: none;
  margin-left: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #f1e2c4;
  color: #7a4a1e;
  font-size: 18rpx;
}

.clink {
  position: relative;
  height: 44rpx;
  display: flex;
  align-items: center;
  padding-left: 42rpx;
}

.cline {
  position: absolute;
  left: 44rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #d8c7ad;
}

.ctag {
  position: relative;
  z-index: 2;
  margin-left: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f7efe2;
  border: 2rpx solid rgba(166, 59, 42, 0.24);
  color: var(--ink-2);
  font-size: var(--fs-20);
}

.racts {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  padding-top: 12rpx;
}

.ract {
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  border: 2rpx solid #d9c3a2;
  background: #fffdf8;
  color: var(--gold-deep);
  font-size: var(--fs-22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ract:active {
  background: #f3eadb;
}

.ract.solid {
  border-color: var(--red);
  background: var(--red);
  color: #fff7ec;
}

.ract.solid:active {
  background: var(--red-deep);
}

.list-end {
  padding: 16rpx 0 8rpx;
  text-align: center;
  font-size: var(--fs-20);
  color: var(--ink-3);
}

.list-gap {
  height: 40rpx;
}

/* ---------------- 空态 ---------------- */
.empty {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}

/* 空态引导：照「年份查询」页写法——一句用法 + 01/02/03 指路卡 */
.sd-lead {
  margin: 4rpx 8rpx 20rpx;
  font-size: var(--fs-26);
  line-height: 1.6;
  color: var(--ink-3);
}

.gcard {
  display: flex;
  gap: 24rpx;
  padding: 34rpx 32rpx 30rpx;
  background: var(--card);
  border: 2rpx solid #e4d7c3;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(61, 46, 31, 0.05);
}

.gcard + .gcard {
  margin-top: 16rpx;
}

/* 编号只做序列感：浅赭色大字，字号明显大于标题，不读作内容 */
.gcard-no {
  flex: none;
  width: 52rpx;
  padding-top: 2rpx;
  font-size: 44rpx;
  line-height: 1.1;
  color: #cbb08c;
}

.gcard-main {
  flex: 1;
  min-width: 0;
}

.gcard-title {
  font-size: var(--fs-30);
  font-weight: 700;
  color: var(--ink);
}

.gcard-desc {
  margin-top: 10rpx;
  font-size: var(--fs-24);
  line-height: 1.7;
  color: var(--ink-3);
}

.gcard-egs {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.gchip {
  padding: 8rpx 20rpx;
  font-size: var(--fs-22);
  color: var(--ink-2);
  background: #fffdf8;
  border: 2rpx solid #e0d2bd;
  border-radius: 999rpx;
}

.gchip:active {
  background: #f3eadb;
  border-color: #d9c3a2;
}

.sec {
  margin-top: 28rpx;
}

.sec-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.sec-t {
  font-size: var(--fs-24);
  font-weight: 700;
  color: var(--ink-2);
}

.sec-a {
  font-size: var(--fs-20);
  color: var(--gold);
}

.recent {
  background: var(--card);
  border: 2rpx solid #e4d7c3;
  border-radius: 18rpx;
  overflow: hidden;
}

.rec {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 18rpx;
}

.rec + .rec {
  border-top: 2rpx solid #ece0cd;
}

.rec-empty {
  height: 76rpx;
  padding: 0 18rpx;
  border: 2rpx dashed #ddd0bc;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  font-size: var(--fs-20);
  color: var(--ink-3);
}

.rec:active {
  background: #f6eddf;
}

.rec-main {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-24);
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rec-meta {
  flex: none;
  margin-left: 12rpx;
  font-size: var(--fs-20);
  color: var(--ink-3);
}

.rec-time {
  flex: none;
  width: 64rpx;
  margin-left: 10rpx;
  text-align: right;
  font-size: 18rpx;
  color: var(--text-muted);
}

.foot {
  margin-top: 22rpx;
  font-size: 18rpx;
  line-height: 1.7;
  color: var(--ink-3);
}

/* ---------------- 加载态 ---------------- */
.loading {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.ld-ring {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid #e3d5c0;
  border-top-color: var(--red);
  animation: sdspin 0.9s linear infinite;
}

@keyframes sdspin {
  to { transform: rotate(360deg); }
}

.ld-t {
  font-size: var(--fs-22);
  color: var(--ink-3);
}

/* ---------------- 图谱页 ----------------
   只在 graphVisible 时用 wx:if 挂载：canvas 在部分 iOS 机型上是原生层，
   会无视祖先的 opacity:0 照常绘制，常驻 DOM 会把下面的搜索卡与空态整块盖住。 */
.graph-page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.ghead {
  flex: none;
  background: linear-gradient(160deg, #2e241a 0%, #3b2c1f 62%, #4a3625 100%);
  color: var(--tile-deep-text);
}

.gnav {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.gback {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 64rpx;
}

.gchev {
  font-size: 48rpx;
  line-height: 1;
}

.gback-t {
  font-size: var(--fs-20);
  color: #d9c7ab;
}

.gtitle {
  flex: 1;
  min-width: 0;
  padding: 0 12rpx;
  text-align: center;
  font-size: var(--fs-28);
  font-weight: 700;
  color: #f8f2e6;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.gdeg {
  flex: none;
  min-width: 64rpx;
  text-align: right;
  font-size: var(--fs-20);
  color: #e4d6bf;
}

.gtool {
  flex: none;
  height: 80rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  gap: 12rpx;
  background: #f7f0e3;
  border-bottom: 2rpx solid #e4d7c3;
}

.pchips {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  white-space: nowrap;
}

.pchip {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  margin: 6rpx 10rpx 6rpx 0;
  padding: 0 16rpx;
  border-radius: 999rpx;
  border: 2rpx solid #dcccb4;
  background: #fffdf8;
  color: var(--ink-2);
  font-size: var(--fs-20);
}

.pchip.on {
  background: var(--red);
  border-color: var(--red);
  color: #fff7ec;
}

.pch-no {
  font-size: var(--fs-22);
  font-weight: 700;
}

.pch-via {
  margin-left: 6rpx;
  font-size: var(--fs-20);
}

.allbtn {
  flex: none;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 14rpx;
  background: #3b2c1f;
  color: #f4e9d6;
  font-size: var(--fs-20);
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.allbtn.on {
  background: var(--gold-deep);
}

.all-ico {
  font-size: var(--fs-20);
}

.all-n {
  font-size: 18rpx;
  color: #d9c7ab;
}

.allbtn.on .all-n {
  color: #f0e0c4;
}

/* 画布 */
.gcanvas-wrap {
  flex: 1;
  min-height: 0;
  position: relative;
  background: #f7f0e3;
  overflow: hidden;
}

.gcanvas {
  width: 100%;
  height: 100%;
  display: block;
}

.gbar {
  position: absolute;
  left: 20rpx;
  top: 16rpx;
  right: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  pointer-events: none;
  z-index: 1;
}

.gbar-t {
  font-size: var(--fs-20);
  font-weight: 700;
  color: var(--ink-2);
}

.gbar-s {
  font-size: 18rpx;
  color: var(--ink-3);
}

.focusbar {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 100rpx;
  z-index: 5;
  min-height: 64rpx;
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(251, 247, 239, 0.96);
  border: 2rpx solid #d9c3a2;
  box-shadow: 0 8rpx 20rpx rgba(61, 46, 31, 0.12);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.focus-t {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-20);
  line-height: 1.4;
  color: var(--ink-2);
}

.focus-a {
  flex: none;
  font-size: var(--fs-20);
  font-weight: 700;
  color: var(--red);
}

.ecard {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 6;
  padding: 14rpx 16rpx;
  border-radius: var(--radius);
  background: rgba(251, 247, 239, 0.98);
  border: 2rpx solid #d9c3a2;
  box-shadow: 0 10rpx 26rpx rgba(61, 46, 31, 0.16);
}

.ec-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ec-title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-24);
  font-weight: 700;
  color: var(--ink);
}

.ec-rel {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #f1e2c4;
  color: #7a4a1e;
  font-size: 18rpx;
}

.ec-sub {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: var(--ink-3);
}

.degrade {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  top: 50%;
  z-index: 9;
  transform: translateY(-50%);
  padding: 32rpx 24rpx;
  text-align: center;
  background: var(--card);
  border: 2rpx solid #d9c3a2;
  border-radius: 20rpx;
  box-shadow: 0 16rpx 40rpx rgba(61, 46, 31, 0.16);
}

.dg-t {
  font-size: var(--fs-28);
  font-weight: 700;
  color: var(--ink);
}

.dg-s {
  margin-top: 12rpx;
  font-size: var(--fs-20);
  line-height: 1.6;
  color: var(--ink-3);
}

.dg-btn {
  margin: 22rpx auto 0;
  width: 240rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: var(--red);
  color: #fff7ec;
  font-size: var(--fs-22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.glegend {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  z-index: 2;
  display: flex;
  gap: 12rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(251, 247, 239, 0.9);
  border: 2rpx solid #e4d7c3;
}

.gl {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 18rpx;
  color: var(--ink-3);
}

.gl-line {
  width: 22rpx;
  height: 4rpx;
  border-radius: 2rpx;
}

.gl-line.blood { background: #c0563f; }
.gl-line.politics { background: #4A7A9B; }
.gl-line.marriage { background: #9C7B5D; }

.zoom-pill {
  position: absolute;
  right: 16rpx;
  bottom: 64rpx;
  z-index: 3;
  min-width: 64rpx;
  height: 44rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(251, 247, 239, 0.94);
  border: 2rpx solid #e4d7c3;
  color: var(--ink-2);
  font-size: var(--fs-20);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 被动状态标签：视觉仍是 44rpx 胶囊，热区扩到 88rpx 但不拦截任何手势 */
.zoom-pill::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 100%;
  min-width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.reset-pill {
  position: absolute;
  right: 16rpx;
  bottom: 118rpx;
  z-index: 3;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #3b2c1f;
  color: #f4e9d6;
  font-size: var(--fs-20);
  display: flex;
  align-items: center;
}
/* 唯一的复位入口：视觉 44rpx，热区纵向扩到 88rpx（44px） */
.reset-pill::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

.ghint {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 2;
  font-size: 18rpx;
  color: var(--text-muted);
}

/* ---------------- 结果头：分享卡入口 ---------------- */
.rhead-l {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rh-share {
  position: relative;
  flex: none;
  margin-left: 12rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 998rpx;
  border: 2rpx solid rgba(166, 59, 42, 0.38);
  background: rgba(166, 59, 42, 0.05);
  color: var(--red);
  font-size: var(--fs-20);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 视觉 52rpx 高，热区补到 88rpx（44px） */
.rh-share::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 88rpx;
  transform: translateY(-50%);
}

.rh-share:active {
  background: rgba(166, 59, 42, 0.12);
}

/* ---------------- 分享卡弹层（C 版） ----------------
   画布只在生成阶段出现（原生层需要真实渲染），
   导出成功后立刻换成 <image>；底部按钮在滚动区之外，不会被内容顶出屏幕。 */
.share-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 900;
}

.share-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 15, 10, 0.62);
}

.share-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 92vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -12rpx 40rpx rgba(20, 15, 10, 0.3);
}

.share-hd {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx 18rpx;
}

.share-t {
  font-size: var(--fs-32);
  font-weight: 700;
  color: var(--ink);
}

.share-x {
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--ink-3);
}

.share-scroll {
  flex: 1;
  min-height: 0;
  max-height: 72vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  text-align: center;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.share-stage {
  position: relative;
  display: inline-block;
  vertical-align: top;
}

.share-canvas {
  display: block;
  background: #fbf7ef;
  border-radius: 12rpx;
  box-shadow: 0 10rpx 30rpx rgba(20, 15, 10, 0.28);
}

.share-loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  border-radius: 12rpx;
  background: rgba(20, 15, 10, 0.42);
  color: #fbf7ef;
  font-size: var(--fs-22);
}

.share-spin {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(229, 183, 127, 0.24);
  border-top-color: #e5b77f;
  animation: sd-share-spin 0.9s linear infinite;
}

@keyframes sd-share-spin {
  to {
    transform: rotate(360deg);
  }
}

.share-img {
  display: block;
  width: 100%;
  border-radius: 12rpx;
  box-shadow: 0 10rpx 30rpx rgba(20, 15, 10, 0.28);
}

.share-fail {
  padding: 90rpx 40rpx 70rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.share-fail-t {
  font-size: var(--fs-26);
  color: var(--ink);
}

.share-fail-s {
  font-size: 22rpx;
  color: var(--ink-3);
}

.share-retry {
  margin-top: 16rpx;
  padding: 0 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 998rpx;
  background: #3b2c1f;
  color: #f6e8cf;
  font-size: var(--fs-26);
}

.share-tip {
  display: block;
  margin: 16rpx 10rpx 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--ink-3);
}

.share-ft {
  flex: none;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 30rpx 26rpx;
}

.share-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
  text-align: center;
  border-radius: 998rpx;
  font-size: var(--fs-28);
  box-sizing: border-box;
}

.share-btn-ghost {
  background: var(--card);
  border: 2rpx solid #d9c3a2;
  color: var(--ink);
}

.share-btn-gold {
  background: linear-gradient(158deg, #3b2c1f, #2e241a);
  color: #f6e8cf;
  font-weight: 600;
}

.share-btn:active {
  opacity: 0.9;
}

/* 原生 button 的默认边框去掉，避免和圆角胶囊打架 */
.share-btn::after {
  border: none;
}

